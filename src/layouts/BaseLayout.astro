---
/**
 * Document shell for every page: metadata from site.yaml, global styles and
 * the client router that animates navigation between pages.
 *
 * It owns everything search engines and link previews read: title,
 * description, canonical URL, social card, breadcrumbs and any JSON-LD the
 * page passes in.
 */
import '@fontsource-variable/inter/opsz.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import type { TransitionAnimationPair } from 'astro';
import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getProjectTerms, getSite } from '../lib/course';
import { href } from '../lib/paths';
import { breadcrumbSchema } from '../lib/schema';

interface Props {
  /** Page name for the tab title; omitted on the home page. */
  title?: string;
  description?: string;
  /** Social card image; defaults to the newest class photo. */
  image?: ImageMetadata;
  /** Pages between Home and this one, e.g. Team on a person page. */
  trail?: { name: string; path: string }[];
  /** Extra JSON-LD objects describing the page. */
  schema?: object[];
}

const site = await getSite();
const { courseCode, title: courseTitle } = site;
const {
  title,
  description = site.description,
  image,
  trail = [],
  schema = [],
} = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const absolute = (path: string) => new URL(path, Astro.site).href;

const cardSource =
  image ??
  (await getProjectTerms()).find((term) => term.classPhoto)?.classPhoto;
const card =
  cardSource &&
  (await getImage({
    src: cardSource,
    width: 1200,
    height: 630,
    fit: 'cover',
    format: 'jpg',
  }));

// Inner pages get a breadcrumb trail starting at Home and ending here.
const jsonLd = title
  ? [
      ...schema,
      breadcrumbSchema([
        { name: 'Home', url: absolute(href('/')) },
        ...trail.map(({ name, path }) => ({ name, url: absolute(href(path)) })),
        { name: title, url: pageUrl.href },
      ]),
    ]
  : schema;
// Old content fades out first and new content rises in after it, so the
// two pages never overlap mid-swap.
const swap: TransitionAnimationPair = {
  old: {
    name: 'fade-out',
    duration: 'var(--duration-fast)',
    easing: 'ease-in',
    fillMode: 'both',
  },
  new: {
    name: 'rise',
    duration: 'var(--duration-base)',
    delay: 'var(--duration-fast)',
    easing: 'var(--ease-out)',
    fillMode: 'both',
  },
};

const fullTitle = title
  ? `${title} · ${courseCode}`
  : `${courseCode} · ${courseTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${courseCode} · ${courseTitle}`} />
    <meta property="og:title" content={title ?? courseTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    {card && <meta property="og:image" content={absolute(card.src)} />}
    {card && <meta property="og:image:width" content="1200" />}
    {card && <meta property="og:image:height" content="630" />}
    <meta
      name="twitter:card"
      content={card ? 'summary_large_image' : 'summary'}
    />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    {!site.indexable && <meta name="robots" content="noindex" />}
    {site.googleSiteVerification.map((token) => (
      <meta name="google-site-verification" content={token} />
    ))}
    {jsonLd.map((data) => (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(data).replace(/</g, '\\u003c')}
      />
    ))}
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <SiteHeader courseCode={courseCode} />
    <main
      id="main-content"
      transition:animate={{ forwards: swap, backwards: swap }}
    >
      <slot />
    </main>
    <SiteFooter courseCode={courseCode} title={courseTitle} />
  </body>
</html>
