---
/**
 * Document shell for every page: metadata from site.yaml, global styles and
 * the client router that animates navigation between pages.
 */
import '@fontsource-variable/inter';
import '@fontsource/libre-caslon-display/latin-400.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { ClientRouter } from 'astro:transitions';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getSite } from '../lib/course';

interface Props {
  /** Page name for the tab title; omitted on the home page. */
  title?: string;
  description?: string;
}

const site = await getSite();
const { courseCode, title: courseTitle, tagline } = site;
const { title, description = site.description } = Astro.props;
const fullTitle = title
  ? `${title} · ${courseCode}`
  : `${courseCode} · ${courseTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {!site.indexable && <meta name="robots" content="noindex" />}
    {site.googleSiteVerification.map((token) => (
      <meta name="google-site-verification" content={token} />
    ))}
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <SiteHeader courseCode={courseCode} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter courseCode={courseCode} title={courseTitle} tagline={tagline} />
  </body>
</html>
