---
/**
 * What past teams built in the capstone, newest term first, with each
 * term's class photo.
 */
import { Image } from 'astro:assets';
import FullSize from '../../components/FullSize.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import Section from '../../components/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getComponent, getProjectTerms, getSite } from '../../lib/course';

const site = await getSite();
const terms = await getProjectTerms();
const count = terms.reduce((sum, term) => sum + term.projects.length, 0);
const { weeks } = await getComponent('capstone');
const capstoneWeeks = weeks.to - weeks.from + 1;
---

<BaseLayout
  title="Projects"
  description={`${count} AI products built by ${site.courseCode} student teams in the ${capstoneWeeks}-week capstone, from chatbots and advisors to agents.`}
>
  <PageHeader
    eyebrow="Past capstone products"
    title="Projects"
    lede="Every term, teams take a product from idea to a working application built on frontier models. These are the products they shipped."
  />
  <div class="terms">
    {terms.map(({ id, label, classPhoto, projects }) => (
      <Section id={id} label={label}>
        <div class="term-body">
          {classPhoto && (
            <figure class="class-photo">
              <FullSize src={classPhoto} label={`The ${label} class photo`}>
                <Image
                  src={classPhoto}
                  alt={`The ${label} ${site.courseCode} class`}
                  widths={[800, 1600]}
                  sizes="(width < 48rem) 100vw, 52rem"
                />
              </FullSize>
              <figcaption>The {label} class</figcaption>
            </figure>
          )}
          {projects.length > 0 && <ProjectGrid projects={projects} />}
        </div>
      </Section>
    ))}
  </div>
</BaseLayout>

<style>
  .terms {
    display: grid;
    gap: var(--space-section);
  }

  .term-body {
    display: grid;
    gap: var(--space-12);
  }

  .class-photo {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .class-photo img {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    object-fit: cover;
  }

  .class-photo figcaption {
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }
</style>
