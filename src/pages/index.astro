---
/**
 * The home page: the course's promise, then the semester as one line.
 *
 * Below the headline, a single line runs down the margin through the week
 * each part begins and on to demo day; scrolling fills it in. The people
 * teaching it close the page. Every value comes from content files, and
 * every detail lives on its own page.
 */
import { Image } from 'astro:assets';
import Arrow from '../components/Arrow.astro';
import PersonRow from '../components/PersonRow.astro';
import Section from '../components/Section.astro';
import SemesterPath from '../components/SemesterPath.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getCurrentStaff,
  getCurrentTerm,
  getOverview,
  getProjectTerms,
  getSite,
} from '../lib/course';
import { href } from '../lib/paths';
import { courseSchema } from '../lib/schema';
import { formatSession } from '../lib/term';

const site = await getSite();
const term = await getCurrentTerm();
const overview = await getOverview();
const staff = await getCurrentStaff();
const instructors = staff.filter(({ role }) => role === 'instructor');
const ROLE_NAMES = {
  instructor: 'Instructor',
  learningAssistant: 'Learning assistant',
};

const projectTerms = await getProjectTerms();
const projects = projectTerms.flatMap((entry) => entry.projects);
const classPhoto = projectTerms.find((entry) => entry.classPhoto);

// One stop where each part begins, then demo day at the capstone's end.
const parts = overview.components.toSorted(
  (a, b) => a.weeks.from - b.weeks.from,
);
const capstone = overview.components.find(({ id }) => id === 'capstone');
const finale = capstone?.steps?.at(-1);
const stops = [
  ...parts.map(({ id, title, promise, weeks }) => ({
    week: weeks.from,
    label: title,
    title: promise,
    href: href(`/${id}/`),
  })),
  ...(capstone && finale
    ? [
        {
          week: capstone.weeks.to,
          label: finale.title,
          title: `${projects.length} products launched so far.`,
          href: href('/projects/'),
        },
      ]
    : []),
];

const absolute = (path: string) => new URL(href(path), Astro.site).href;
const course = courseSchema({
  name: site.title,
  courseCode: site.courseCode,
  description: site.description,
  url: absolute('/'),
  term: term.label,
  ...(term.meetings[0] && { location: term.meetings[0].location }),
  instructors: instructors.map(({ person }) => ({
    name: person.data.name,
    url: absolute(`/team/${person.id}/`),
  })),
});
---

<BaseLayout schema={[course]}>
  <header class="page-width hero">
    <p class="eyebrow">
      {site.courseCode} · {site.title}
    </p>
    <h1 class="hero-title">{overview.headline}</h1>
    <p class="data">
      {site.tagline} · {term.label}
      {term.meetings.map((meeting) => ` · ${formatSession(meeting)}`)}
    </p>
  </header>

  <SemesterPath stops={stops} />

  <div class="sections">
    <Section id="team" label={`Taught in ${term.label} by`}>
      <ul class="plain-list team-grid">
        {staff.map(({ person, role }) => (
          <li>
            <PersonRow person={person} caption={ROLE_NAMES[role]} />
          </li>
        ))}
      </ul>
      {classPhoto?.classPhoto && (
        <figure class="class-photo">
          <Image
            src={classPhoto.classPhoto}
            alt={`The ${classPhoto.label} class of ${site.courseCode}`}
            widths={[800, 1600, 2400]}
            sizes="(width < 70rem) 100vw, 64rem"
          />
          <figcaption class="data">{classPhoto.label} class</figcaption>
        </figure>
      )}
      <p class="more-link">
        <a class="arrow-link" href={href('/team/')}>
          Office hours and past staff
          <Arrow />
        </a>
      </p>
    </Section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-16) var(--space-section);
  }

  /* Parts rise in one after another; reduced motion makes this instant. */
  .hero > * {
    animation: rise var(--duration-slow) var(--ease-out) both;
  }

  .hero > :nth-child(2) {
    animation-delay: 60ms;
  }

  .hero > :nth-child(3) {
    animation-delay: 120ms;
  }

  .hero-title {
    max-width: 14ch;
    font-size: var(--text-display);
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }

  .sections {
    margin-top: var(--space-section);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: 0 var(--space-8);
  }

  .class-photo {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-8) 0 0;
  }

  .class-photo img {
    width: 100%;
    aspect-ratio: 21 / 9;
    border-radius: var(--radius);
    object-fit: cover;
  }

  .more-link {
    margin-top: var(--space-8);
  }
</style>
