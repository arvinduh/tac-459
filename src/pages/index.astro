---
/**
 * The home page: the course told as a short story for prospective students.
 *
 * Each band answers one question a visitor asks, in this order, with a
 * picture first: what will I make (the product wall), is it real (counts),
 * what does it take (the semester map), who teaches it (faces and a class
 * photo), and where next (links into the detail pages). Every value comes
 * from content files, and every detail lives on its own page.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Arrow from '../components/Arrow.astro';
import PersonRow from '../components/PersonRow.astro';
import ProductWall from '../components/ProductWall.astro';
import Section from '../components/Section.astro';
import SemesterMap from '../components/SemesterMap.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getCurrentStaff,
  getCurrentTerm,
  getOverview,
  getProjectTerms,
  getSite,
} from '../lib/course';
import { href } from '../lib/paths';
import { courseSchema } from '../lib/schema';
import { formatSession, termRank } from '../lib/term';

const site = await getSite();
const term = await getCurrentTerm();
const overview = await getOverview();
const staff = await getCurrentStaff();
const instructors = staff.filter(({ role }) => role === 'instructor');
const ROLE_NAMES = {
  instructor: 'Instructor',
  learningAssistant: 'Learning assistant',
};

const projectTerms = await getProjectTerms();
const projects = projectTerms.flatMap((entry) => entry.projects);
const classPhoto = projectTerms.find((entry) => entry.classPhoto);
const terms = (await getCollection('terms')).sort(
  (a, b) => termRank(a.id) - termRank(b.id),
);
const weeks = Math.max(...overview.components.map(({ weeks }) => weeks.to));

const stats = [
  { value: projects.length, label: 'products shipped by student teams' },
  {
    value: terms.length,
    label: `terms taught since ${terms[0]?.data.label ?? term.label}`,
  },
  { value: weeks, label: 'weeks from first lecture to launch pitch' },
];

const absolute = (path: string) => new URL(href(path), Astro.site).href;
const course = courseSchema({
  name: site.title,
  courseCode: site.courseCode,
  description: site.description,
  url: absolute('/'),
  term: term.label,
  ...(term.meetings[0] && { location: term.meetings[0].location }),
  instructors: instructors.map(({ person }) => ({
    name: person.data.name,
    url: absolute(`/team/${person.id}/`),
  })),
});
---

<BaseLayout schema={[course]}>
  <header class="page-width hero">
    <p class="eyebrow">
      {site.courseCode} · {site.title}
    </p>
    <h1 class="hero-title">{overview.headline}</h1>
    <p class="hero-lede">{overview.lede}</p>
    <div class="link-row">
      <a class="arrow-link" href={href('/curriculum/')}>
        Explore the curriculum
        <Arrow />
      </a>
      <a class="arrow-link" href={href('/projects/')}>
        See every product
        <Arrow />
      </a>
    </div>
  </header>

  <ProductWall projects={projects} />

  <div class="sections">
    <section class="page-width" aria-label="By the numbers">
      <dl class="stats">
        {stats.map(({ value, label }) => (
          <div class="stat reveal">
            <dt class="visually-hidden">{label}</dt>
            <dd class="stat-value">{value}</dd>
            <dd class="stat-label" aria-hidden="true">
              {label}
            </dd>
          </div>
        ))}
      </dl>
      <p class="term-line data">
        {site.tagline} · {term.label}
        {term.meetings.map((meeting) => ` · ${formatSession(meeting)}`)}
      </p>
    </section>

    <Section id="semester" label="One semester, three parts">
      <SemesterMap parts={overview.components} />
    </Section>

    <Section id="team" label={`Taught in ${term.label} by`}>
      <ul class="plain-list team-grid">
        {staff.map(({ person, role }) => (
          <li class="reveal">
            <PersonRow person={person} caption={ROLE_NAMES[role]} />
          </li>
        ))}
      </ul>
      {classPhoto?.classPhoto && (
        <figure class="class-photo reveal">
          <Image
            src={classPhoto.classPhoto}
            alt={`The ${classPhoto.label} class of ${site.courseCode}`}
            widths={[800, 1600, 2400]}
            sizes="(width < 70rem) 100vw, 64rem"
          />
          <figcaption class="data">{classPhoto.label} class</figcaption>
        </figure>
      )}
      <p class="more-link">
        <a class="arrow-link" href={href('/team/')}>
          Office hours and past staff
          <Arrow />
        </a>
      </p>
    </Section>

    <section class="page-width closing" aria-labelledby="closing-heading">
      <h2 class="closing-title" id="closing-heading">
        See what you would build.
      </h2>
      <div class="link-row">
        <a class="arrow-link" href={href('/curriculum/')}>
          The curriculum, week by week
          <Arrow />
        </a>
        <a class="arrow-link" href={href('/capstone/')}>
          The nine-week capstone
          <Arrow />
        </a>
        <a class="arrow-link" href={href('/projects/')}>
          All {projects.length} student products
          <Arrow />
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-16) var(--space-12);
  }

  /* Parts rise in one after another; reduced motion makes this instant. */
  .hero > * {
    animation: rise var(--duration-slow) var(--ease-out) both;
  }

  .hero > :nth-child(2) {
    animation-delay: 60ms;
  }

  .hero > :nth-child(3) {
    animation-delay: 120ms;
  }

  .hero > :nth-child(4) {
    animation-delay: 180ms;
  }

  .hero-title {
    max-width: 14ch;
    font-size: var(--text-display);
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }

  .hero-lede {
    max-width: var(--prose-max);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.55;
  }

  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-8);
  }

  .sections {
    display: grid;
    gap: var(--space-section);
    margin-top: var(--space-section);
  }

  /* Big figures, each with what it counts underneath. */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4) var(--space-8);
    margin: 0;
  }

  .stat dd {
    margin: 0;
  }

  .stat-value {
    font-size: var(--text-display);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }

  .stat-label {
    max-width: 16rem;
    margin-top: var(--space-3);
    color: var(--color-text-muted);
  }

  @media (width < 36rem) {
    .stat-label {
      font-size: var(--text-sm);
    }
  }

  .term-line {
    margin-top: var(--space-12);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: 0 var(--space-8);
  }

  .class-photo {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-8) 0 0;
  }

  .class-photo img {
    width: 100%;
    aspect-ratio: 21 / 9;
    border-radius: var(--radius);
    object-fit: cover;
  }

  .more-link {
    margin-top: var(--space-8);
  }

  .closing {
    display: grid;
    gap: var(--space-8);
  }

  .closing-title {
    max-width: 14ch;
    font-size: var(--text-title);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
  }
</style>
