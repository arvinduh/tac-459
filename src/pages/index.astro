---
/**
 * The home page: the course's promise, then the semester it takes.
 *
 * The first screen holds the headline, the blurb, the class facts and the
 * semester line, whose bars open each part in place. The line is the
 * page's only picture, and it is real course information. The people
 * teaching follow. Every value comes from content files.
 */
import Arrow from '../components/Arrow.astro';
import PersonRow from '../components/PersonRow.astro';
import Section from '../components/Section.astro';
import SemesterLine from '../components/SemesterLine.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getClassCalendar,
  getCurrentStaff,
  getCurrentTerm,
  getModules,
  getOverview,
  getSite,
  ROLE_NAMES,
} from '../lib/course';
import { href } from '../lib/paths';
import { courseSchema } from '../lib/schema';
import {
  buildLanes,
  formatTimes,
  googleCalendarUrl,
  mapUrl,
  scheduleUrl,
} from '@tac/content';

const site = await getSite();
const term = await getCurrentTerm();
const overview = await getOverview();
const staff = await getCurrentStaff();
const instructors = staff.filter(({ role }) => role === 'instructor');
const modules = await getModules();
const parts = overview.parts.toSorted((a, b) => a.weeks.from - b.weeks.from);
const { last, lanes } = buildLanes(parts, modules);

const absolute = (path: string) => new URL(href(path), Astro.site).href;
const calendar = await getClassCalendar(absolute('/'));
const course = courseSchema({
  name: site.title,
  courseCode: site.courseCode,
  description: site.description,
  url: absolute('/'),
  term: term.label,
  ...(term.meetings[0] && { location: term.meetings[0].location }),
  instructors: instructors.map(({ person }) => ({
    name: person.data.name,
    url: absolute(`/team/${person.id}/`),
  })),
});
---

<BaseLayout schema={[course]}>
  <header class="page-width hero">
    <p class="data">
      {site.courseCode} · {site.title}
    </p>
    <h1 class="hero-title">{overview.headline}</h1>
    <div class="hero-row">
      <p class="hero-blurb">{overview.blurb}</p>
      <p class="data hero-facts">
        <a href={scheduleUrl(term.id, site.courseCode)}>{term.label}</a>
        {term.meetings.map((meeting, index) => {
          const map = mapUrl(meeting.location, site.buildings);
          const series = calendar.series[index];
          return (
            <>
              {series ? (
                <a
                  href={googleCalendarUrl(calendar.text, series)}
                  data-tip="Add the class to Google Calendar"
                >
                  {formatTimes(meeting)}
                </a>
              ) : (
                <span>{formatTimes(meeting)}</span>
              )}
              {map ? (
                <a href={map}>{meeting.location}</a>
              ) : (
                <span>{meeting.location}</span>
              )}
            </>
          );
        })}
      </p>
    </div>
    <div class="hero-semester">
      <SemesterLine last={last} lanes={lanes} />
      <p class="links">
        <a class="arrow-link" href={href('/course/')}>
          The course week by week
          <Arrow />
        </a>
        <a class="arrow-link" href={href('/projects/')}>
          What past teams shipped
          <Arrow />
        </a>
      </p>
    </div>
  </header>

  <div class="sections">
    <Section id="team" label={`Taught in ${term.label} by`}>
      <ul class="plain-list team-grid">
        {staff.map(({ person, role }) => (
          <li>
            <PersonRow person={person} caption={ROLE_NAMES[role]} />
          </li>
        ))}
      </ul>
      <p class="links">
        <a class="arrow-link" href={href('/team/')}>
          Office hours and past staff
          <Arrow />
        </a>
      </p>
    </Section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-8);
    padding-top: var(--space-16);
  }

  /* Parts rise in one after another; reduced motion makes this instant. */
  .hero > * {
    animation: rise var(--duration-slow) var(--ease-out) both;
  }

  .hero > :nth-child(2) {
    animation-delay: 60ms;
  }

  .hero > :nth-child(3) {
    animation-delay: 120ms;
  }

  .hero > :nth-child(4) {
    animation-delay: 180ms;
  }

  /* Wide enough that the headline sets in three balanced lines. */
  .hero-title {
    max-width: 14ch;
    font-size: var(--text-display);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .hero-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-4) var(--space-8);
    align-items: end;
  }

  .hero-blurb {
    max-width: var(--prose-max);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .hero-semester {
    margin-top: var(--space-8);
  }

  .sections {
    display: grid;
    gap: var(--space-section);
    margin-block: var(--space-section);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-8);
    margin-top: var(--space-8);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: 0 var(--space-8);
  }

  @media (width < 48rem) {
    .hero {
      padding-top: var(--space-12);
    }

    .hero-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-blurb {
      font-size: var(--text-base);
    }
  }
</style>
