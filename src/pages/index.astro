---
/**
 * The home page: the course pitch for prospective students.
 *
 * It summarizes each part of the site and links into it, so every detail
 * lives on exactly one page. Every value comes from content files.
 */
import PersonRow from '../components/PersonRow.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getCurrentStaff,
  getCurrentTerm,
  getOverview,
  getProjectTerms,
  getSite,
} from '../lib/course';
import { href } from '../lib/paths';
import { courseSchema } from '../lib/schema';
import { formatSession } from '../lib/term';

const site = await getSite();
const term = await getCurrentTerm();
const overview = await getOverview();
const staff = await getCurrentStaff();
const instructors = staff.filter(({ role }) => role === 'instructor');
const ROLE_NAMES = {
  instructor: 'Instructor',
  learningAssistant: 'Learning assistant',
};

const latest = (await getProjectTerms()).find(
  (entry) => entry.projects.length > 0,
);

const absolute = (path: string) => new URL(href(path), Astro.site).href;
const course = courseSchema({
  name: site.title,
  courseCode: site.courseCode,
  description: site.description,
  url: absolute('/'),
  term: term.label,
  ...(term.meetings[0] && { location: term.meetings[0].location }),
  instructors: instructors.map(({ person }) => ({
    name: person.data.name,
    url: absolute(`/team/${person.id}/`),
  })),
});

const meetings = term.meetings.map(formatSession);
---

<BaseLayout schema={[course]}>
  <header class="page-width hero">
    <p class="eyebrow">{site.tagline}</p>
    <h1 class="hero-title">{site.title}</h1>
    <p class="hero-lede">{overview.lede}</p>
    <ul class="plain-list hero-meta data">
      <li>{term.label}</li>
      {meetings.map((meeting) => (
        <li>{meeting}</li>
      ))}
    </ul>
  </header>

  <div class="sections">
    <Section id="course" label="The course">
      <p class="intro">{overview.intro}</p>
      <ol class="plain-list component-list">
        {overview.components.map(({ id, title, timing, summary }, index) => (
          <li class="numbered-row">
            <span class="numeral">{String(index + 1).padStart(2, '0')}</span>
            <div class="component-body">
              <h3 class="component-title">
                <a href={href(`/${id}/`)}>{title}</a>
              </h3>
              <p class="component-timing">{timing}</p>
              <p class="component-summary">{summary}</p>
            </div>
          </li>
        ))}
      </ol>
    </Section>

    {latest && (
      <Section id="projects" label="Recent projects">
        <ProjectGrid projects={latest.projects.slice(0, 2)} />
        <p class="more-link">
          <a href={href('/projects/')}>See every term's projects</a>
        </p>
      </Section>
    )}

    <Section id="team" label={`${term.label} team`}>
      <ul class="plain-list team-grid">
        {staff.map(({ person, role }) => (
          <li>
            <PersonRow person={person} caption={ROLE_NAMES[role]} />
          </li>
        ))}
      </ul>
      <p class="more-link">
        <a href={href('/team/')}>Meet the whole team</a>
      </p>
    </Section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-section);
  }

  /* Parts rise in one after another; reduced motion makes this instant. */
  .hero > * {
    animation: rise var(--duration-slow) var(--ease-out) both;
  }

  .hero > :nth-child(2) {
    animation-delay: 60ms;
  }

  .hero > :nth-child(3) {
    animation-delay: 120ms;
  }

  .hero > :nth-child(4) {
    animation-delay: 180ms;
  }

  .hero-title {
    max-width: 16ch;
    font-size: var(--text-display);
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }

  .hero-lede {
    max-width: var(--prose-max);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.55;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
    margin-top: var(--space-4);
  }

  .sections {
    display: grid;
    gap: var(--space-section);
  }

  .intro {
    max-width: var(--prose-max);
    margin-bottom: var(--space-12);
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
    line-height: 1.4;
    letter-spacing: var(--tracking-heading);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 0 var(--space-8);
  }

  .component-body {
    display: grid;
    gap: var(--space-2);
  }

  .component-title {
    font-size: var(--text-lg);
  }

  .component-title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .component-title a::after {
    color: var(--color-brand);
    content: ' →';
    transition: margin var(--duration-fast) var(--ease-out);
  }

  .component-title a:hover::after {
    margin-left: 0.2em;
  }

  .component-timing {
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .component-summary {
    max-width: var(--prose-max);
    color: var(--color-text-muted);
  }

  .more-link {
    margin-top: var(--space-8);
    font-weight: var(--weight-medium);
  }
</style>
