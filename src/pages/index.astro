---
/**
 * The course overview, written for prospective students.
 *
 * One page in four parts: what the course is, how it is structured, what
 * it covers week to week, and who teaches it. Every value comes from
 * content files, so the page rolls forward with the term file.
 */
import PersonRow from '../components/PersonRow.astro';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getCurrentStaff,
  getCurrentTerm,
  getModules,
  getOverview,
  getSite,
} from '../lib/course';
import { formatClock } from '../lib/term';

const site = await getSite();
const term = await getCurrentTerm();
const overview = await getOverview();
const modules = await getModules();
const staff = await getCurrentStaff();

const meetings = term.meetings.map(
  ({ days, start, end, location }) =>
    `${days.join(' & ')}, ${formatClock(start)}–${formatClock(end)} · ${location}`,
);

const teamGroups = [
  { role: 'instructor', heading: 'Instructors' },
  { role: 'learningAssistant', heading: 'Learning assistants' },
].map(({ role, heading }) => ({
  heading,
  members: staff.filter((member) => member.role === role),
}));
---

<BaseLayout>
  <header class="page-width hero">
    <p class="hero-eyebrow">{site.tagline}</p>
    <h1 class="hero-title">{site.title}</h1>
    <p class="hero-lede">{overview.lede}</p>
    <ul class="hero-meta">
      <li>{term.label}</li>
      {meetings.map((meeting) => (
        <li>{meeting}</li>
      ))}
    </ul>
  </header>

  <div class="sections">
    <Section id="course" number={1} label="Course">
      <p class="intro">{overview.intro}</p>
      <ol class="row-list">
        {overview.components.map(({ title, timing, summary }) => (
          <li class="component">
            <p class="row-meta">{timing}</p>
            <h3 class="row-title">{title}</h3>
            <p class="row-text">{summary}</p>
          </li>
        ))}
      </ol>
    </Section>

    <Section id="curriculum" number={2} label="Curriculum">
      <ol class="row-list">
        {modules.map(({ title, weeks }, index) => (
          <li class="module">
            <span class="module-number">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div class="module-body">
              <h3 class="row-title">{title}</h3>
              <ul class="topic-list">
                {weeks.map((week) => (
                  <li>{week.title}</li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </Section>

    <Section id="team" number={3} label="Team">
      <div class="team">
        {teamGroups.map(({ heading, members }) => (
          <div class="team-group">
            <h3 class="row-meta">{heading}</h3>
            <ul class="row-list">
              {members.map(({ person }) => (
                <li>
                  <PersonRow person={person} />
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </Section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-section);
  }

  /* Parts rise in one after another; reduced motion makes this instant. */
  .hero > * {
    animation: rise var(--duration-slow) var(--ease-out) both;
  }

  .hero > :nth-child(2) {
    animation-delay: 80ms;
  }

  .hero > :nth-child(3) {
    animation-delay: 160ms;
  }

  .hero > :nth-child(4) {
    animation-delay: 240ms;
  }

  .hero-eyebrow,
  .hero-meta,
  .row-meta,
  .module-number {
    color: var(--color-text-subtle);
    font: 400 var(--text-xs) / 1.6 var(--font-mono);
  }

  .hero-title {
    max-width: 15ch;
    font: 300 var(--text-display) / 1 var(--font-serif);
    letter-spacing: -0.015em;
  }

  .hero-lede {
    max-width: var(--prose-max);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .sections {
    display: grid;
    gap: var(--space-section);
  }

  .intro {
    max-width: var(--prose-max);
    margin-bottom: var(--space-12);
    font: 400 var(--text-xl) / 1.35 var(--font-serif);
  }

  .row-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row-list > li + li {
    border-top: 1px solid var(--color-rule);
  }

  .component {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-8);
  }

  .component:first-child,
  .module:first-child {
    padding-top: 0;
  }

  .row-title {
    font: 400 var(--text-lg) / 1.25 var(--font-serif);
  }

  .row-text {
    max-width: var(--prose-max);
    color: var(--color-text-muted);
  }

  .module {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-8);
  }

  .module-number {
    padding-top: 0.3em;
  }

  .module-body {
    display: grid;
    gap: var(--space-3);
  }

  .topic-list {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    list-style: none;
  }

  .team {
    display: grid;
    gap: var(--space-12);
  }

  .team-group {
    display: grid;
    gap: var(--space-2);
  }
</style>
