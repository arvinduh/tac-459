---
/**
 * The home page: the course's promise, then the semester as one line.
 *
 * Below the headline, a single line runs down the margin through the week
 * each part begins and on to demo day; scrolling fills it in. The people
 * teaching it close the page. Every value comes from content files, and
 * every detail lives on its own page.
 */
import Arrow from '../components/Arrow.astro';
import PersonRow from '../components/PersonRow.astro';
import Section from '../components/Section.astro';
import SemesterStory from '../components/SemesterStory.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { googleCalendarUrl } from '../lib/calendar';
import {
  getClassCalendar,
  getCurrentStaff,
  getCurrentTerm,
  getOverview,
  getProjectTerms,
  getSite,
  ROLE_NAMES,
} from '../lib/course';
import { href } from '../lib/paths';
import { courseSchema } from '../lib/schema';
import { formatTimes, mapUrl, scheduleUrl } from '../lib/term';

const site = await getSite();
const term = await getCurrentTerm();
const overview = await getOverview();
const staff = await getCurrentStaff();
const instructors = staff.filter(({ role }) => role === 'instructor');
const projectTerms = await getProjectTerms();
const projects = projectTerms.flatMap((entry) => entry.projects);

// One stop where each part begins, then demo day at the capstone's end.
const parts = overview.components.toSorted(
  (a, b) => a.weeks.from - b.weeks.from,
);
const capstone = overview.components.find(({ id }) => id === 'capstone');
const finale = capstone?.steps?.at(-1);
const stops = [
  ...parts.map(({ id, title, promise, summary, weeks }) => ({
    week: weeks.from,
    label: title,
    title: promise,
    text: summary,
    href: href(`/${id}/`),
  })),
  ...(capstone && finale
    ? [
        {
          week: capstone.weeks.to,
          label: finale.title,
          title: `${projects.length} products launched so far.`,
          text: finale.text,
          href: href('/projects/'),
        },
      ]
    : []),
];

const absolute = (path: string) => new URL(href(path), Astro.site).href;
const calendar = await getClassCalendar(absolute('/'));
const course = courseSchema({
  name: site.title,
  courseCode: site.courseCode,
  description: site.description,
  url: absolute('/'),
  term: term.label,
  ...(term.meetings[0] && { location: term.meetings[0].location }),
  instructors: instructors.map(({ person }) => ({
    name: person.data.name,
    url: absolute(`/team/${person.id}/`),
  })),
});
---

<BaseLayout schema={[course]}>
  <header class="page-width hero">
    <p class="eyebrow">
      {site.courseCode} · {site.title}
    </p>
    <h1 class="hero-title">{overview.headline}</h1>
    <p class="hero-blurb">{overview.blurb}</p>
    <div class="hero-facts">
      <p class="data">
        <a href={scheduleUrl(term.id, site.courseCode)}>{term.label}</a>
        {term.meetings.map((meeting, index) => {
          const map = mapUrl(meeting.location, site.buildings);
          const series = calendar.series[index];
          return (
            <>
              {' · '}
              {series ? (
                <a
                  href={googleCalendarUrl(calendar.text, series)}
                  title="Add the class to Google Calendar"
                >
                  {formatTimes(meeting)}
                </a>
              ) : (
                formatTimes(meeting)
              )}
              {' · '}
              {map ? <a href={map}>{meeting.location}</a> : meeting.location}
            </>
          );
        })}
      </p>
    </div>
  </header>

  <SemesterStory
    panels={stops}
    covers={projects.slice(0, 8).map(({ data }) => data.images[0])}
  />

  <div class="sections">
    <Section id="team" label={`Taught in ${term.label} by`}>
      <ul class="plain-list team-grid">
        {staff.map(({ person, role }) => (
          <li>
            <PersonRow person={person} caption={ROLE_NAMES[role]} />
          </li>
        ))}
      </ul>
      <p class="more-link">
        <a class="arrow-link" href={href('/team/')}>
          Office hours and past staff
          <Arrow />
        </a>
      </p>
    </Section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-16) var(--space-section);
  }

  /* Parts rise in one after another; reduced motion makes this instant. */
  .hero > * {
    animation: rise var(--duration-slow) var(--ease-out) both;
  }

  .hero > :nth-child(2) {
    animation-delay: 60ms;
  }

  .hero > :nth-child(3) {
    animation-delay: 120ms;
  }

  .hero > :nth-child(4) {
    animation-delay: 180ms;
  }

  /* Wide enough that the headline breaks into two lines on a laptop. */
  .hero-title {
    max-width: 22ch;
    font-size: var(--text-display);
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }

  .hero-blurb {
    max-width: var(--prose-max);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.55;
  }

  .hero-facts {
    display: grid;
    gap: var(--space-3);
  }

  .sections {
    margin-top: var(--space-section);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: 0 var(--space-8);
  }

  .more-link {
    margin-top: var(--space-8);
  }
</style>
