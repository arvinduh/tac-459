---
/**
 * The home page: the course pitch for prospective students.
 *
 * It summarizes each part of the site and links into it, so every detail
 * lives on exactly one page. Every value comes from content files.
 */
import Arrow from '../components/Arrow.astro';
import PersonRow from '../components/PersonRow.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Section from '../components/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getCurrentStaff,
  getCurrentTerm,
  getOverview,
  getProjectTerms,
  getSite,
} from '../lib/course';
import { href } from '../lib/paths';
import { courseSchema } from '../lib/schema';
import { formatTimes } from '../lib/term';

const site = await getSite();
const term = await getCurrentTerm();
const overview = await getOverview();
const staff = await getCurrentStaff();
const instructors = staff.filter(({ role }) => role === 'instructor');
const ROLE_NAMES = {
  instructor: 'Instructor',
  learningAssistant: 'Learning assistant',
};

const projectTerms = await getProjectTerms();
const latest = projectTerms.find((entry) => entry.projects.length > 0);
const productCount = projectTerms.reduce(
  (sum, entry) => sum + entry.projects.length,
  0,
);

const absolute = (path: string) => new URL(href(path), Astro.site).href;
const course = courseSchema({
  name: site.title,
  courseCode: site.courseCode,
  description: site.description,
  url: absolute('/'),
  term: term.label,
  ...(term.meetings[0] && { location: term.meetings[0].location }),
  instructors: instructors.map(({ person }) => ({
    name: person.data.name,
    url: absolute(`/team/${person.id}/`),
  })),
});

const facts = [
  { label: 'Term', value: term.label },
  ...term.meetings.flatMap((meeting) => [
    { label: 'Meets', value: formatTimes(meeting) },
    { label: 'Room', value: meeting.location },
  ]),
  { label: 'Student products', value: String(productCount) },
];
---

<BaseLayout schema={[course]}>
  <header class="page-width hero">
    <p class="eyebrow">{site.tagline}</p>
    <h1 class="hero-title">{site.title}</h1>
    <p class="hero-lede">{overview.lede}</p>
    <div class="hero-actions">
      <a class="arrow-link" href={href('/curriculum/')}>
        Explore the curriculum
        <Arrow />
      </a>
      <a class="arrow-link" href={href('/projects/')}>
        See student projects
        <Arrow />
      </a>
    </div>
    <dl class="hero-facts">
      {facts.map(({ label, value }) => (
        <div>
          <dt>{label}</dt>
          <dd class="data">{value}</dd>
        </div>
      ))}
    </dl>
  </header>

  <div class="sections">
    <Section id="course" label="The course">
      <p class="intro">{overview.intro}</p>
      <ol class="plain-list component-list">
        {overview.components.map(({ id, title, timing, summary }, index) => (
          <li class="numbered-row reveal">
            <span class="numeral">{String(index + 1).padStart(2, '0')}</span>
            <div class="component-body">
              <h3 class="component-title">
                <a href={href(`/${id}/`)}>
                  {title}
                  <Arrow />
                </a>
              </h3>
              <p class="component-timing">{timing}</p>
              <p class="component-summary">{summary}</p>
            </div>
          </li>
        ))}
      </ol>
    </Section>

    {latest && (
      <Section id="projects" label="Recent projects">
        <ProjectGrid projects={latest.projects.slice(0, 2)} />
        <p class="more-link">
          <a class="arrow-link" href={href('/projects/')}>
            See all {productCount} products
            <Arrow />
          </a>
        </p>
      </Section>
    )}

    <Section id="team" label={`${term.label} team`}>
      <ul class="plain-list team-grid">
        {staff.map(({ person, role }) => (
          <li class="reveal">
            <PersonRow person={person} caption={ROLE_NAMES[role]} />
          </li>
        ))}
      </ul>
      <p class="more-link">
        <a class="arrow-link" href={href('/team/')}>
          Office hours and past staff
          <Arrow />
        </a>
      </p>
    </Section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-section);
  }

  /* Parts rise in one after another; reduced motion makes this instant. */
  .hero > * {
    animation: rise var(--duration-slow) var(--ease-out) both;
  }

  .hero > :nth-child(2) {
    animation-delay: 60ms;
  }

  .hero > :nth-child(3) {
    animation-delay: 120ms;
  }

  .hero > :nth-child(4) {
    animation-delay: 180ms;
  }

  .hero > :nth-child(5) {
    animation-delay: 240ms;
  }

  .hero-title {
    max-width: 16ch;
    font-size: var(--text-display);
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }

  .hero-lede {
    max-width: var(--prose-max);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-8);
    margin-top: var(--space-2);
  }

  /* Facts sit in a ruled row, like a spec sheet: label over value. */
  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-12);
    margin: var(--space-12) 0 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-rule);
  }

  .hero-facts dt {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .hero-facts dd {
    margin: 0;
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  .sections {
    display: grid;
    gap: var(--space-section);
  }

  .intro {
    max-width: var(--prose-max);
    margin-bottom: var(--space-12);
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
    line-height: 1.4;
    letter-spacing: var(--tracking-heading);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 0 var(--space-8);
  }

  .component-body {
    display: grid;
    gap: var(--space-2);
  }

  .component-title {
    font-size: var(--text-lg);
  }

  .component-title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .component-title a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .component-title a:hover {
    color: var(--color-brand);
  }

  .component-title :global(.arrow) {
    color: var(--color-brand);
  }

  .component-timing {
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .component-summary {
    max-width: var(--prose-max);
    color: var(--color-text-muted);
  }

  .more-link {
    margin-top: var(--space-8);
  }
</style>
