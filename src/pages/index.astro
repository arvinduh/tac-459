---
/**
 * The home page: the course's promise over a picture of what it teaches,
 * then the semester at a glance and the people teaching it.
 *
 * The picture is self-attention drawn over the headline itself, the idea
 * the curriculum opens on. The semester line opens each part in place and
 * links to the Course page for the rest. Every value comes from content
 * files.
 */
import Arrow from '../components/Arrow.astro';
import Attention from '../components/Attention.astro';
import PersonRow from '../components/PersonRow.astro';
import Section from '../components/Section.astro';
import SemesterLine from '../components/SemesterLine.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getClassCalendar,
  getCurrentStaff,
  getCurrentTerm,
  getModules,
  getOverview,
  getSite,
  ROLE_NAMES,
} from '../lib/course';
import { href } from '../lib/paths';
import { courseSchema } from '../lib/schema';
import {
  buildLanes,
  formatTimes,
  googleCalendarUrl,
  mapUrl,
  scheduleUrl,
} from '@tac/content';

const site = await getSite();
const term = await getCurrentTerm();
const overview = await getOverview();
const staff = await getCurrentStaff();
const instructors = staff.filter(({ role }) => role === 'instructor');
const modules = await getModules();
const parts = overview.parts.toSorted((a, b) => a.weeks.from - b.weeks.from);
const { last, lanes } = buildLanes(parts, modules);

// The week the curriculum teaches attention, which the picture draws.
const firstWeek = parts.find(({ id }) => id === 'curriculum')?.weeks.from ?? 1;
const attentionWeek = modules
  .flatMap(({ weeks }) => weeks)
  .findIndex(({ title }) => /attention/i.test(title));

const absolute = (path: string) => new URL(href(path), Astro.site).href;
const calendar = await getClassCalendar(absolute('/'));
const course = courseSchema({
  name: site.title,
  courseCode: site.courseCode,
  description: site.description,
  url: absolute('/'),
  term: term.label,
  ...(term.meetings[0] && { location: term.meetings[0].location }),
  instructors: instructors.map(({ person }) => ({
    name: person.data.name,
    url: absolute(`/team/${person.id}/`),
  })),
});
---

<BaseLayout schema={[course]}>
  <header class="hero">
    <div class="page-width hero-inner">
      <div class="hero-head">
        <p class="data">
          {site.courseCode} · {site.title}
        </p>
        <h1 class="hero-title">{overview.headline}</h1>
      </div>
      <figure class="hero-picture">
        <Attention sentence={overview.headline} />
      </figure>
      <p class="hero-blurb">{overview.blurb}</p>
      <div class="hero-aside">
        <p class="data hero-facts">
          <a href={scheduleUrl(term.id, site.courseCode)}>{term.label}</a>
          {term.meetings.map((meeting, index) => {
            const map = mapUrl(meeting.location, site.buildings);
            const series = calendar.series[index];
            return (
              <>
                {' · '}
                {series ? (
                  <a
                    href={googleCalendarUrl(calendar.text, series)}
                    data-tip="Add the class to Google Calendar"
                  >
                    {formatTimes(meeting)}
                  </a>
                ) : (
                  formatTimes(meeting)
                )}
                {' · '}
                {map ? <a href={map}>{meeting.location}</a> : meeting.location}
              </>
            );
          })}
        </p>
        <p class="data">
          Above, self-attention over the headline
          {attentionWeek >= 0 &&
            `, taught in week ${firstWeek + attentionWeek}`}
          . Point at a word.
        </p>
      </div>
    </div>
  </header>

  <div class="sections">
    <Section id="semester" label="One semester, three parts">
      <SemesterLine last={last} lanes={lanes} />
      <p class="links">
        <a class="arrow-link" href={href('/course/')}>
          The course week by week
          <Arrow />
        </a>
        <a class="arrow-link" href={href('/projects/')}>
          What past teams shipped
          <Arrow />
        </a>
      </p>
    </Section>

    <Section id="team" label={`Taught in ${term.label} by`}>
      <ul class="plain-list team-grid">
        {staff.map(({ person, role }) => (
          <li>
            <PersonRow person={person} caption={ROLE_NAMES[role]} />
          </li>
        ))}
      </ul>
      <p class="links">
        <a class="arrow-link" href={href('/team/')}>
          Office hours and past staff
          <Arrow />
        </a>
      </p>
    </Section>
  </div>
</BaseLayout>

<style>
  /* A dark band, the site's one, so the picture's Gold reads as light. */
  .hero {
    background: var(--color-night);
    color: var(--color-night-text);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--space-12) var(--space-16);
    padding-block: var(--space-16) var(--space-12);
  }

  .hero-head,
  .hero-picture {
    grid-column: 1 / -1;
  }

  .hero-head {
    display: grid;
    gap: var(--space-6);
  }

  .hero-aside {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding-top: 0.4em;
  }

  /* Parts rise in one after another; reduced motion makes this instant. */
  .hero-inner > * {
    animation: rise var(--duration-slow) var(--ease-out) both;
  }

  .hero-inner > :nth-child(2) {
    animation-delay: 60ms;
  }

  .hero-inner > :nth-child(3) {
    animation-delay: 120ms;
  }

  .hero-inner > :nth-child(4) {
    animation-delay: 180ms;
  }

  .hero .data {
    color: var(--color-night-muted);
  }

  .hero a {
    color: var(--color-night-text);
    text-decoration-color: color-mix(
      in srgb,
      var(--color-night-text) 35%,
      transparent
    );
  }

  .hero a:hover {
    color: var(--color-accent);
    text-decoration-color: currentcolor;
  }

  .hero :focus-visible {
    outline-color: var(--color-accent);
  }

  .hero-title {
    font-size: var(--text-display);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    max-width: 20ch;
    text-wrap: balance;
  }

  .hero-blurb {
    max-width: var(--prose-max);
    color: var(--color-night-muted);
    font-size: var(--text-lg);
    line-height: 1.55;
  }

  .hero-picture {
    margin: 0;
  }

  .sections {
    display: grid;
    gap: var(--space-section);
    margin-block: var(--space-section);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-8);
    margin-top: var(--space-8);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: 0 var(--space-8);
  }

  @media (width < 56rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      padding-top: var(--space-12);
    }
  }
</style>
