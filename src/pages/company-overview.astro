---
/**
 * The AI company overview: the midsemester industry case study, step by step.
 */
import NextPage from '../components/NextPage.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import StepList from '../components/StepList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getComponent } from '../lib/course';
import { formatWeeks } from '../lib/term';

const { title, weeks, summary, detail, steps } =
  await getComponent('company-overview');
const next = await getComponent('capstone');
---

<BaseLayout title={title} description={summary}>
  <PageHeader eyebrow={formatWeeks(weeks)} title={title} lede={detail} />
  <Section id="steps" label="How it works">
    <StepList steps={steps} />
  </Section>
  <NextPage path={`/${next.id}/`} title={next.title} text={next.summary} />
</BaseLayout>
