---
/**
 * The AI capstone product: the nine-week build from idea to launch pitch.
 */
import NextPage from '../components/NextPage.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import StepList from '../components/StepList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getComponent } from '../lib/course';

const { title, timing, summary, detail, steps } =
  await getComponent('capstone');
---

<BaseLayout title={title} description={summary}>
  <PageHeader eyebrow={timing} title={title} lede={detail} />
  <Section id="roadmap" label="Roadmap">
    <StepList steps={steps} />
  </Section>
  <NextPage
    path="/projects/"
    title="Past projects"
    text="What past teams built in these nine weeks, with screenshots and links."
  />
</BaseLayout>
