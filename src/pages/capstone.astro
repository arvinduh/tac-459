---
/**
 * The AI capstone product: the nine-week build from idea to launch pitch.
 */
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import StepList from '../components/StepList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getComponent } from '../lib/course';
import { href } from '../lib/paths';

const { title, timing, summary, detail, steps } =
  await getComponent('capstone');
---

<BaseLayout title={title} description={summary}>
  <PageHeader eyebrow={timing} title={title} lede={detail} />
  <Section id="roadmap" label="Roadmap">
    <StepList steps={steps} />
    <p class="next-link">
      <a href={href('/projects/')}>See what past teams built</a>
    </p>
  </Section>
</BaseLayout>

<style>
  .next-link {
    margin-top: var(--space-12);
    font-weight: var(--weight-medium);
  }
</style>
