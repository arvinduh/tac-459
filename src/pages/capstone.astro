---
/**
 * The AI capstone product: the nine-week build from idea to launch pitch.
 */
import NextPage from '../components/NextPage.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import StepList from '../components/StepList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getComponent } from '../lib/course';
import { formatWeeks } from '../lib/term';

const { title, summary, detail, steps, weeks } = await getComponent('capstone');
// The roadmap is one step per week, so its weeks come from `weeks` alone.
if (steps.length !== weeks.to - weeks.from + 1) {
  throw new Error(
    `overview.yaml: the capstone spans weeks ${weeks.from}–${weeks.to} ` +
      `but has ${steps.length} steps; it needs one per week`,
  );
}
---

<BaseLayout title={title} description={summary}>
  <PageHeader eyebrow={formatWeeks(weeks)} title={title} lede={detail} />
  <Section id="roadmap" label="Roadmap">
    <StepList steps={steps} firstWeek={weeks.from} />
  </Section>
  <NextPage
    path="/projects/"
    title="Past projects"
    text="What past teams built on this roadmap, with screenshots of each product."
  />
</BaseLayout>
