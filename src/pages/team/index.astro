---
/**
 * This term's teaching team, grouped by role, then a timeline of everyone
 * who has taught the course; each person links to their own page.
 */
import PageHeader from '../../components/PageHeader.astro';
import PersonRow from '../../components/PersonRow.astro';
import Section from '../../components/Section.astro';
import StaffTimeline from '../../components/StaffTimeline.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCurrentStaff, getCurrentTerm, getSite } from '../../lib/course';
import { formatSession } from '../../lib/term';

const site = await getSite();
const term = await getCurrentTerm();
const staff = await getCurrentStaff();

const groups = [
  { id: 'instructors', role: 'instructor', label: 'Instructors' },
  {
    id: 'learning-assistants',
    role: 'learningAssistant',
    label: 'Learning assistants',
  },
].map((group) => ({
  ...group,
  members: staff.filter((member) => member.role === group.role),
}));

const description = `The ${term.label} instructors and learning assistants of ${site.courseCode}, ${site.title}.`;
---

<BaseLayout title="Team" description={description}>
  <PageHeader
    eyebrow={term.label}
    title="Team"
    lede={`The instructors and learning assistants teaching ${site.courseCode} in ${term.label}.`}
  />
  <div class="groups">
    {groups.map(({ id, label, members }) => (
      <Section id={id} label={label}>
        <ul class="plain-list person-list">
          {members.map(({ person, officeHours }) => (
            <li class="reveal">
              <PersonRow
                person={person}
                withSummary
                {...(officeHours && {
                  detail: `Office hours · ${
                    typeof officeHours === 'string'
                      ? officeHours
                      : formatSession(officeHours)
                  }`,
                })}
              />
            </li>
          ))}
        </ul>
      </Section>
    ))}
    <Section id="over-the-years" label="Over the years">
      <StaffTimeline currentTermId={site.currentTerm.id} />
    </Section>
  </div>
</BaseLayout>

<style>
  .groups {
    display: grid;
    gap: var(--space-section);
  }

  .person-list > li + li {
    border-top: 1px solid var(--color-rule);
  }

  .person-list > li:first-child :global(.person-row) {
    padding-top: 0;
  }
</style>
