---
/**
 * This term's teaching team, grouped by role, then everyone who taught
 * before; each person links to their own page.
 */
import PageHeader from '../../components/PageHeader.astro';
import PersonRow from '../../components/PersonRow.astro';
import Section from '../../components/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getCurrentStaff,
  getCurrentTerm,
  getPastStaff,
  getSite,
} from '../../lib/course';
import { href } from '../../lib/paths';

const site = await getSite();
const term = await getCurrentTerm();
const staff = await getCurrentStaff();
const pastStaff = await getPastStaff();

const groups = [
  { id: 'instructors', role: 'instructor', label: 'Instructors' },
  {
    id: 'learning-assistants',
    role: 'learningAssistant',
    label: 'Learning assistants',
  },
].map((group) => ({
  ...group,
  members: staff.filter((member) => member.role === group.role),
}));

const description = `The ${term.label} instructors and learning assistants of ${site.courseCode}, ${site.title}.`;
---

<BaseLayout title="Team" description={description}>
  <PageHeader
    eyebrow={term.label}
    title="Team"
    lede={`The instructors and learning assistants teaching ${site.courseCode} in ${term.label}.`}
  />
  <div class="groups">
    {groups.map(({ id, label, members }) => (
      <Section id={id} label={label}>
        <ul class="plain-list person-list">
          {members.map(({ person }) => (
            <li>
              <PersonRow person={person} />
            </li>
          ))}
        </ul>
      </Section>
    ))}
    {pastStaff.length > 0 && (
      <Section id="past-staff" label="Past staff">
        <ul class="plain-list past-list">
          {pastStaff.map(({ person, terms }) => (
            <li class="past-row">
              <a href={href(`/team/${person.id}/`)}>{person.data.name}</a>
              <span class="past-terms">{terms.join(', ')}</span>
            </li>
          ))}
        </ul>
      </Section>
    )}
  </div>
</BaseLayout>

<style>
  .groups {
    display: grid;
    gap: var(--space-section);
  }

  .person-list > li + li {
    border-top: 1px solid var(--color-rule);
  }

  .person-list > li:first-child :global(.person-row) {
    padding-top: 0;
  }

  .past-list {
    display: grid;
    gap: var(--space-3);
  }

  .past-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-6);
  }

  .past-row a {
    color: var(--color-text);
    font-weight: var(--weight-medium);
    text-decoration-color: var(--color-rule);
  }

  .past-row a:hover {
    text-decoration-color: var(--color-accent);
  }

  .past-terms {
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }
</style>
