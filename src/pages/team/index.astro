---
/** This term's teaching team, instructors first, from the term file. */
import PageIntro from '../../components/PageIntro.astro';
import PersonCard from '../../components/PersonCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCurrentStaff, getCurrentTerm } from '../../lib/course';

const term = await getCurrentTerm();
const staff = await getCurrentStaff();

const groups = [
  { role: 'instructor', heading: 'Instructors' },
  { role: 'learningAssistant', heading: 'Learning assistants' },
].map(({ role, heading }) => ({
  heading,
  id: `${role}-heading`,
  members: staff.filter((member) => member.role === role),
}));
---

<BaseLayout title="Team">
  <PageIntro eyebrow={term.label} title="Team">
    The people teaching {term.label}.
  </PageIntro>

  <div class="page-width groups">
    {groups.map(({ heading, id, members }) => (
      <section class="group" aria-labelledby={id}>
        <h2 id={id} class="group-heading">
          {heading}
        </h2>
        <div class="card-grid">
          {members.map(({ person }) => (
            <PersonCard person={person} />
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .groups {
    display: grid;
    gap: var(--space-16);
  }

  .group {
    display: grid;
    gap: var(--space-6);
  }

  .group-heading {
    font: var(--text-2xl) / 1.2 var(--font-serif);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr));
    gap: var(--space-6);
  }
</style>
