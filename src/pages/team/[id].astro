---
/**
 * One person's page: portrait, roles, contact links and full bio.
 *
 * Every person ever on staff gets a page, so past staff keep a stable URL.
 */
import { getImage, Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BackLink from '../../components/BackLink.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { personSchema } from '../../lib/schema';

interface Props {
  person: CollectionEntry<'people'>;
}

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map((person) => ({
    params: { id: person.id },
    props: { person },
  }));
}

const { person } = Astro.props;
const { name, honorific, positions, email, links, photo } = person.data;
const displayName = honorific ? `${honorific} ${name}` : name;
const { Content } = await render(person);

const portrait = await getImage({ src: photo, width: 480, format: 'webp' });
const schema = personSchema({
  name,
  url: new URL(Astro.url.pathname, Astro.site).href,
  image: new URL(portrait.src, Astro.site).href,
  jobTitle: positions,
  sameAs: [links.linkedin, links.viterbi].filter(
    (link) => typeof link === 'string',
  ),
});

const contacts = [
  email && { label: 'Email', url: `mailto:${email}` },
  links.linkedin && { label: 'LinkedIn', url: links.linkedin },
  links.viterbi && { label: 'USC Viterbi', url: links.viterbi },
].filter((contact) => typeof contact === 'object');
---

<BaseLayout
  title={name}
  description={positions.join(' · ')}
  trail={[{ name: 'Team', path: '/team/' }]}
  schema={[schema]}
>
  <article class="page-width person">
    <header class="person-header">
      <BackLink path="/team/" label="Team" />
      <Image
        class="person-photo"
        src={photo}
        alt={`Portrait of ${name}`}
        width={240}
        height={240}
        loading="eager"
        transition:name={`photo-${person.id}`}
      />
      <h1 class="person-name" transition:name={`name-${person.id}`}>
        {displayName}
      </h1>
      <ul class="person-roles">
        {positions.map((position) => (
          <li>{position}</li>
        ))}
      </ul>
    </header>

    <div class="person-grid">
      {contacts.length > 0 && (
        <ul class="contact-list" aria-label="Contact">
          {contacts.map(({ label, url }) => (
            <li>
              <a href={url}>{label}</a>
            </li>
          ))}
        </ul>
      )}
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .person {
    display: grid;
    gap: var(--space-16);
  }

  .person-header {
    display: grid;
    justify-items: start;
    gap: var(--space-6);
    padding-top: var(--space-12);
  }

  .person-header > :not(.person-photo) {
    animation: rise var(--duration-slow) var(--ease-out) both;
  }

  .person-header :global(.back-link) {
    margin-bottom: var(--space-8);
  }

  .contact-list {
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .person-photo {
    width: 7.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--color-rule);
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  .person-name {
    font-size: var(--text-title);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
  }

  .person-roles {
    margin: 0;
    padding: 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.5;
    list-style: none;
  }

  /* Same two-column grid as every page section. */
  .person-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-rule);
  }

  @media (width < 48rem) {
    .person-grid {
      grid-template-columns: 1fr;
    }
  }

  .contact-list {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-list a {
    color: var(--color-text);
  }

  .prose {
    grid-column: -2;
    display: grid;
    gap: var(--space-4);
    max-width: var(--prose-max);
  }

  .prose :global(h2) {
    margin-top: var(--space-8);
    font-size: var(--text-lg);
  }

  .prose :global(ul) {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: 1.1em;
    color: var(--color-text-muted);
  }

  .prose :global(strong) {
    font-weight: var(--weight-semibold);
  }
</style>
