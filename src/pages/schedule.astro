---
/**
 * Week-by-week schedule: topics from the curriculum, dates from the term.
 *
 * Each week carries its date range as data attributes so the browser can
 * mark the current week without the build knowing today's date.
 */
import CurrentWeek from '../components/CurrentWeek.astro';
import DueList from '../components/DueList.astro';
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getCurrentTerm,
  getDeliverableTitles,
  getModules,
  getSite,
} from '../lib/course';
import {
  dueKey,
  formatDay,
  formatDue,
  isoDay,
  weekIndexOf,
  weekOf,
} from '../lib/term';

interface DueItem {
  title: string;
  when?: string;
}

const { timeZone } = await getSite();
const term = await getCurrentTerm();
const modules = await getModules();
const titles = await getDeliverableTitles();
const weekCount = modules.reduce((count, { weeks }) => count + weeks.length, 0);

// Dated deliverables go in the week their date falls in. Anything after the
// last teaching week collects at index `weekCount`, shown as finals.
const datedIds = new Set(term.due.map(({ deliverable }) => deliverable.id));
const datedByWeek = new Map<number, DueItem[]>();
const byDueTime = term.due.toSorted((a, b) =>
  dueKey(a.date, a.time).localeCompare(dueKey(b.date, b.time)),
);
for (const { deliverable, date, time } of byDueTime) {
  const index = Math.min(
    Math.max(weekIndexOf(term.startDate, date), 0),
    weekCount,
  );
  const item = {
    title: titles.get(deliverable.id) ?? deliverable.id,
    when: formatDue(date, time),
  };
  datedByWeek.set(index, [...(datedByWeek.get(index) ?? []), item]);
}
const finals = datedByWeek.get(weekCount) ?? [];

// Week numbers run across modules, so each week's index is global.
let weekIndex = 0;
const schedule = modules.map(({ title, weeks }, moduleIndex) => ({
  number: moduleIndex + 1,
  title,
  weeks: weeks.map((week) => {
    const { start, end } = weekOf(term.startDate, weekIndex);
    const undated: DueItem[] = week.due
      .filter(({ id }) => !datedIds.has(id))
      .map(({ id }) => ({ title: titles.get(id) ?? id }));
    const due = [...undated, ...(datedByWeek.get(weekIndex) ?? [])];
    weekIndex += 1;
    return {
      ...week,
      number: weekIndex,
      start: isoDay(start),
      before: isoDay(weekOf(term.startDate, weekIndex).start),
      range: `${formatDay(start)} – ${formatDay(end)}`,
      due,
    };
  }),
}));
---

<BaseLayout title="Schedule">
  <PageIntro eyebrow={term.label} title="Schedule">
    {weekCount} weeks across {modules.length} modules, from text processing to
    frontier models.
  </PageIntro>

  <CurrentWeek timeZone={timeZone}>
    <div class="page-width modules">
      {schedule.map(({ number, title, weeks }) => (
        <section
          id={`module-${number}`}
          class="module"
          aria-labelledby={`module-${number}-title`}
        >
          <h2 id={`module-${number}-title`} class="module-heading">
            <span class="module-number">Module {number}</span>
            {title}
          </h2>
          <ol class="week-list">
            {weeks.map((week) => (
              <li
                class="week"
                data-start={week.start}
                data-before={week.before}
              >
                <div class="week-when">
                  <span class="week-number">Week {week.number}</span>
                  <span class="week-range">{week.range}</span>
                  <span class="week-now">This week</span>
                </div>
                <div class="week-body">
                  <h3 class="week-title">{week.title}</h3>
                  <ul class="topic-list">
                    {week.core.map((topic) => (
                      <li>{topic}</li>
                    ))}
                  </ul>
                  {week.deeper.length > 0 && (
                    <details class="deeper">
                      <summary>Go deeper</summary>
                      <ul class="topic-list">
                        {week.deeper.map((topic) => (
                          <li>{topic}</li>
                        ))}
                      </ul>
                    </details>
                  )}
                  {week.due.length > 0 && <DueList items={week.due} />}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
      {finals.length > 0 && (
        <section class="module" aria-labelledby="finals-title">
          <h2 id="finals-title" class="module-heading">
            <span class="module-number">After week {weekCount}</span>
            Finals
          </h2>
          <div class="week week-finals">
            <DueList items={finals} />
          </div>
        </section>
      )}
    </div>
  </CurrentWeek>
</BaseLayout>

<style>
  .modules {
    display: grid;
    gap: var(--space-16);
  }

  .module {
    display: grid;
    gap: var(--space-6);
  }

  .module-heading {
    display: grid;
    gap: var(--space-1);
    font: var(--text-2xl) / 1.2 var(--font-display);
  }

  .module-number {
    color: var(--color-brand);
    font: 600 var(--text-sm) / 1.4 var(--font-sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .week-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .week {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition:
      border-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  @media (width < 40rem) {
    .week {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }

  .week[data-current] {
    border-color: var(--color-brand);
    box-shadow:
      inset 4px 0 0 var(--color-brand),
      var(--shadow-2);
  }

  .week-now {
    display: none;
    width: fit-content;
    margin-top: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-brand);
    color: var(--color-on-brand);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .week[data-current] .week-now {
    display: block;
  }

  .week-finals {
    grid-template-columns: 1fr;
  }

  .week-when {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    font-variant-numeric: tabular-nums;
  }

  .week-number {
    font-weight: 600;
  }

  .week-range {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .week-body {
    display: grid;
    gap: var(--space-3);
  }

  .week-title {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .topic-list {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding-left: var(--space-6);
    color: var(--color-text-muted);
  }

  /* Opens smoothly where the browser can animate to auto height. */
  .deeper {
    interpolate-size: allow-keywords;
  }

  .deeper::details-content {
    height: 0;
    overflow: clip;
    transition:
      height var(--duration-base) var(--ease-out),
      content-visibility var(--duration-base) allow-discrete;
  }

  .deeper[open]::details-content {
    height: auto;
  }

  .deeper summary {
    width: fit-content;
    color: var(--color-brand);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .deeper .topic-list {
    padding-top: var(--space-2);
  }
</style>
