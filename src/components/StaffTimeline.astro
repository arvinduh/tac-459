---
/**
 * Who taught which terms: one column per term, one row per lane, a bar per
 * unbroken run of terms.
 *
 * It is a table because it is tabular data: column headers name the terms
 * and colspan carries each run's length, so no positional styles are needed.
 * People who never overlap share a lane, so each role takes only as many
 * rows as its busiest term. Wide timelines scroll sideways, opening at the
 * newest term, and role labels and names stay in view while they scroll.
 *
 * Bars are quiet fills with a role-colored edge, Cardinal for instructors
 * and Gold for learning assistants; people still teaching get a warmer
 * fill and full-strength names, so the current team reads first.
 */
import { getStaffTimeline } from '../lib/course';
import { href } from '../lib/paths';

interface Props {
  /** Term to mark as current. */
  currentTermId: string;
}

const { currentTermId } = Astro.props;
const { terms, groups } = await getStaffTimeline();
const currentIndex = terms.findIndex(({ id }) => id === currentTermId);

const LABELS = {
  instructor: 'Instructors',
  learningAssistant: 'Learning assistants',
};

type Person = (typeof groups)[number]['people'][number]['person'];
type Cell = { span: number; person?: Person; current?: boolean };

/** One lane's cells, left to right: a bar where a run starts, else a gap. */
function laneCells(people: (typeof groups)[number]['people'], lane: number) {
  const starts = new Map<number, Cell>();
  for (const { person, runs } of people.filter((p) => p.lane === lane)) {
    for (const [first, last] of runs) {
      starts.set(first, {
        person,
        span: last - first + 1,
        current: last === currentIndex,
      });
    }
  }
  const cells: Cell[] = [];
  for (let index = 0; index < terms.length;) {
    const cell = starts.get(index) ?? { span: 1 };
    cells.push(cell);
    index += cell.span;
  }
  return cells;
}

const sections = groups.map(({ role, laneCount, people }) => ({
  role,
  lanes: Array.from({ length: laneCount }, (_, lane) =>
    laneCells(people, lane),
  ),
}));
---

<div class="timeline-scroll" data-timeline>
  <table class="timeline">
    <caption class="visually-hidden">Teaching staff by term</caption>
    <colgroup>
      <col class="term-col" span={terms.length} />
    </colgroup>
    <thead>
      <tr>
        {terms.map(({ id, label }) => (
          <th
            scope="col"
            class:list={['term', 'data', { current: id === currentTermId }]}
          >
            {label}
          </th>
        ))}
      </tr>
    </thead>
    {sections.map(({ role, lanes }) => (
      <tbody class={`group group-${role}`}>
        <tr>
          <th scope="rowgroup" colspan={terms.length} class="group-label">
            <span class="sticky-text">{LABELS[role]}</span>
          </th>
        </tr>
        {lanes.map((cells) => (
          <tr>
            {cells.map(({ span, person, current }) => (
              <td colspan={span > 1 ? span : undefined}>
                {person && (
                  <a
                    class:list={['bar', { current }]}
                    href={href(`/team/${person.id}/`)}
                    title={person.data.name}
                  >
                    <span class="sticky-text">{person.data.name}</span>
                  </a>
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    ))}
  </table>
</div>

<script>
  // Open each timeline at its newest term; reruns after client navigation.
  document.addEventListener('astro:page-load', () => {
    for (const scroller of document.querySelectorAll('[data-timeline]')) {
      scroller.scrollLeft = scroller.scrollWidth;
    }
  });
</script>

<style>
  .timeline-scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }

  /*
   * Fixed layout sizes columns from the colgroup alone: every term gets the
   * same width, the table fills the page, and it scrolls once the terms
   * outgrow it.
   */
  .timeline {
    width: max-content;
    min-width: 100%;
    border-collapse: separate;
    border-spacing: 0 var(--space-1);
    table-layout: fixed;
  }

  /* Wide enough for a full name in a one-term bar. */
  .term-col {
    width: 10.5rem;
  }

  .timeline td,
  .timeline th {
    padding: 0 var(--space-1);
    font-weight: var(--weight-regular);
    text-align: left;
  }

  /* Each term opens with a tick, so bars visibly start on a term. */
  .timeline .term {
    padding: 0 var(--space-2) var(--space-2);
    border-left: 1px solid var(--color-rule);
  }

  .term.current {
    border-left-color: var(--color-brand);
    color: var(--color-brand);
  }

  .group-label {
    padding-block: var(--space-4) var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Labels and names slide along their row so they never scroll away. */
  .sticky-text {
    position: sticky;
    left: var(--space-2);
  }

  /* Names never widen a column; the colgroup alone sets the grid. */
  .bar {
    --edge: var(--color-text-subtle);
    display: block;
    contain: inline-size;
    overflow: clip;
    padding: var(--space-1) var(--space-2) var(--space-1) var(--space-3);
    border-radius: 3px;
    background: var(--color-surface);
    box-shadow: inset 2px 0 0 var(--edge);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .group-instructor .bar {
    --edge: var(--color-brand);
  }

  .group-learningAssistant .bar {
    --edge: var(--color-accent);
  }

  .bar.current {
    background: color-mix(in srgb, var(--edge) 7%, var(--color-bg));
    color: var(--color-text);
  }

  .bar:hover {
    background: color-mix(in srgb, var(--edge) 16%, var(--color-bg));
    color: var(--color-text);
  }

  /*
   * Bars draw in from their start as the timeline scrolls into view. The
   * timeline is named on the scroller, since the scroller itself is the
   * nearest scroll container of every bar.
   */
  @supports (animation-timeline: view()) {
    .timeline-scroll {
      view-timeline: --staff-timeline block;
    }

    .bar {
      animation: draw linear both;
      animation-timeline: --staff-timeline;
      animation-range: entry 10% entry 90%;
    }
  }

  @keyframes draw {
    from {
      clip-path: inset(0 100% 0 0 round 3px);
    }

    to {
      clip-path: inset(0 0 0 0 round 3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar {
      animation: none;
    }
  }
</style>
