---
/**
 * Wraps an image in a link to its full-size file, so a cropped class photo
 * or a scaled screenshot can be seen whole.
 *
 * The file is one WebP at the source's own width; the browser opens it
 * directly, so no viewer script ships.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  /** What the image shows, for the link's accessible name. */
  label: string;
}

const { src, label } = Astro.props;
const full = await getImage({ src, width: src.width, format: 'webp' });
---

<a class="full-size" href={full.src} aria-label={`${label}, full size`}>
  <slot />
</a>

<style>
  .full-size {
    display: block;
    cursor: zoom-in;
  }
</style>
