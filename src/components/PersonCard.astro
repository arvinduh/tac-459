---
/**
 * One staff member on the team page, linking to their own page.
 *
 * The photo and name share transition names with the person page, so they
 * morph into place on navigation instead of cutting.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { href } from '../lib/paths';

interface Props {
  person: CollectionEntry<'people'>;
  officeHours?: string | undefined;
}

const { person, officeHours } = Astro.props;
const { name, honorific, positions, photo, summary } = person.data;
const displayName = honorific ? `${honorific} ${name}` : name;
---

<article class="person-card">
  <Image
    class="person-photo"
    src={photo}
    alt={`Portrait of ${name}`}
    width={192}
    height={192}
    transition:name={`photo-${person.id}`}
  />
  <div class="person-body">
    <h3 class="person-name" transition:name={`name-${person.id}`}>
      <a class="person-link" href={href(`/team/${person.id}/`)}>
        {displayName}
      </a>
    </h3>
    <ul class="person-positions">
      {positions.map((position) => (
        <li>{position}</li>
      ))}
    </ul>
    {summary && <p class="person-summary">{summary}</p>}
    {officeHours && (
      <p class="person-hours">
        <span class="person-hours-label">Office hours</span>
        {officeHours}
      </p>
    )}
  </div>
</article>

<style>
  .person-card {
    position: relative;
    display: grid;
    grid-template-columns: 6rem 1fr;
    align-items: start;
    gap: var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-1);
    transition:
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  @media (width < 30rem) {
    .person-card {
      grid-template-columns: 4rem 1fr;
      gap: var(--space-4);
      padding: var(--space-4);
    }
  }

  .person-card:hover {
    box-shadow: var(--shadow-2);
    transform: translateY(-2px);
  }

  .person-photo {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-surface-sunken);
    box-shadow:
      0 0 0 3px var(--color-surface),
      0 0 0 4px var(--color-border);
    object-fit: cover;
  }

  .person-body {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  .person-name {
    font: var(--text-xl) / 1.2 var(--font-display);
  }

  .person-link {
    color: var(--color-text);
    text-decoration: none;
  }

  /* Stretches the name's link over the card so the whole card is clickable. */
  .person-link::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .person-card:hover .person-link {
    color: var(--color-brand);
  }

  .person-positions {
    margin: 0;
    padding: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    list-style: none;
  }

  .person-summary {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    font-size: var(--text-sm);
  }

  .person-hours {
    display: grid;
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .person-hours-label {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
