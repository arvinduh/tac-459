---
/**
 * The site's navigation: inline links on wide screens, a sheet on phones.
 *
 * One list serves both. On phones it is a native popover opened by the
 * Menu button, so light dismiss, Esc and focus return need no JavaScript;
 * from the wide breakpoint up the same element shows inline and the button
 * hides. The links stay in the HTML for crawlers either way. In the sheet
 * each link adds a short note drawn from content, previewing the page.
 */
import {
  getComponent,
  getCurrentTerm,
  getModules,
  getProjectTerms,
} from '../lib/course';
import { NAV_LINKS, isCurrentPath } from '../lib/nav';
import { href } from '../lib/paths';

const [modules, company, capstone, projectTerms, term] = await Promise.all([
  getModules(),
  getComponent('company-overview'),
  getComponent('capstone'),
  getProjectTerms(),
  getCurrentTerm(),
]);
const weeks = modules.reduce((sum, module) => sum + module.weeks.length, 0);
const products = projectTerms.reduce(
  (sum, entry) => sum + entry.projects.length,
  0,
);

const NOTES: Record<(typeof NAV_LINKS)[number]['path'], string> = {
  '/curriculum/': `${weeks} weeks`,
  '/company-overview/': company.timing,
  '/capstone/': capstone.timing,
  '/projects/': `${products} products`,
  '/team/': term.label,
};

const here = Astro.url.pathname;
---

<button
  class="menu-toggle"
  type="button"
  popovertarget="site-menu"
  aria-label="Menu"
>
  <span class="toggle-bars" aria-hidden="true"></span>
</button>

<nav class="menu" id="site-menu" popover aria-label="Site">
  <ul class="plain-list menu-list">
    {NAV_LINKS.map(({ label, path }) => (
      <li>
        <a
          href={href(path)}
          aria-current={isCurrentPath(here, path) ? 'page' : undefined}
        >
          <span class="menu-label">{label}</span>
          <span class="menu-note data">{NOTES[path]}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  /* Phones: the toggle shows and the list is a sheet below the header. */
  .menu-toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-right: calc(-1 * var(--space-2));
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--color-text);
    cursor: pointer;
  }

  /* Two lines that cross into a close mark while the sheet is open. */
  .toggle-bars {
    position: relative;
    width: 1.125rem;
    height: 0.5rem;
  }

  .toggle-bars::before,
  .toggle-bars::after {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    border-radius: 1px;
    background: currentcolor;
    content: '';
    transition: transform var(--duration-base) var(--ease-out);
  }

  .toggle-bars::before {
    top: 0;
  }

  .toggle-bars::after {
    bottom: 0;
  }

  :global(.site-header:has(.menu:popover-open)) .toggle-bars::before {
    transform: translateY(calc(0.25rem - 0.75px)) rotate(45deg);
  }

  :global(.site-header:has(.menu:popover-open)) .toggle-bars::after {
    transform: translateY(calc(-0.25rem + 0.75px)) rotate(-45deg);
  }

  /*
   * The sheet fills the screen below the header and fades in while its
   * links settle a few pixels; only opacity and transform animate, so it
   * stays smooth on phones. The page behind does not scroll while open.
   */
  .menu {
    position: fixed;
    inset: var(--header-height) 0 0;
    width: auto;
    height: auto;
    margin: 0;
    padding: var(--space-4) var(--gutter) var(--space-12);
    border: 0;
    background: var(--color-bg);
    color: var(--color-text);
    opacity: 0;
    transition:
      opacity var(--duration-fast) ease,
      overlay var(--duration-base) allow-discrete,
      display var(--duration-base) allow-discrete;
  }

  .menu:popover-open {
    opacity: 1;
    transition-duration: var(--duration-base);
  }

  @starting-style {
    .menu:popover-open {
      opacity: 0;
    }
  }

  :global(html:has(.menu:popover-open)) {
    overflow: hidden;
  }

  .menu-list li {
    transform: translateY(-6px);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .menu:popover-open .menu-list li {
    transform: none;
  }

  @starting-style {
    .menu:popover-open .menu-list li {
      transform: translateY(-6px);
    }
  }

  .menu-list li + li {
    border-top: 1px solid var(--color-rule);
  }

  .menu-list a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    color: var(--color-text);
    text-decoration: none;
  }

  .menu-label {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-heading);
  }

  .menu-list a[aria-current='page'] .menu-label {
    color: var(--color-brand);
  }

  .menu-note {
    white-space: nowrap;
  }

  /*
   * Wide screens: the popover shows inline as a row of quiet links, and
   * the current page takes a Cardinal rule under its name.
   */
  @media (width >= 52rem) {
    .menu-toggle {
      display: none;
    }

    .menu {
      display: block;
      position: static;
      padding: 0;
      background: none;
      opacity: 1;
    }

    .menu-list {
      display: flex;
      gap: var(--space-8);
    }

    .menu-list li {
      transform: none;
    }

    .menu-list li + li {
      border: 0;
    }

    .menu-list a {
      padding-block: var(--space-2);
      color: var(--color-text-muted);
      text-decoration: underline 2px transparent;
      text-underline-offset: 0.6em;
      transition:
        color var(--duration-fast) var(--ease-out),
        text-decoration-color var(--duration-fast) var(--ease-out);
    }

    .menu-list a:hover {
      color: var(--color-text);
      text-decoration-color: var(--color-rule);
    }

    .menu-list a[aria-current='page'] {
      color: var(--color-text);
      text-decoration-color: var(--color-brand);
    }

    .menu-label {
      font-size: var(--text-sm);
      font-weight: var(--weight-medium);
      letter-spacing: 0;
    }

    .menu-list a[aria-current='page'] .menu-label {
      color: inherit;
    }

    .menu-note {
      display: none;
    }
  }
</style>
