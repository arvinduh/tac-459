---
/** Opening block of an inner page: eyebrow, title and a short lede. */
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<header class="page-width page-intro">
  <p class="eyebrow">{eyebrow}</p>
  <h1 class="page-title">{title}</h1>
  <p class="page-lede">
    <slot />
  </p>
</header>

<style>
  .page-intro {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-16) var(--space-12);
  }

  .page-intro > * {
    animation: rise var(--duration-slow) var(--ease-out) both;
  }

  .page-lede {
    max-width: 60ch;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    animation-delay: 120ms;
  }

  .eyebrow {
    color: var(--color-brand);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .page-title {
    font: var(--text-display) / 1.05 var(--font-display);
    animation-delay: 60ms;
  }
</style>
