---
/**
 * The opening of an inner page: the page's one h1 and an optional lede.
 * No label sits above the title; the heading carries its own weight.
 *
 * Its parts rise in one after another on load, like the home page hero.
 */
interface Props {
  title: string;
  lede?: string;
}

const { title, lede } = Astro.props;
---

<header class="page-width page-header">
  <h1 class="page-title">{title}</h1>
  {lede && <p class="page-lede">{lede}</p>}
</header>

<style>
  .page-header {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-16) var(--space-section);
  }

  .page-header > * {
    animation: rise var(--duration-slow) var(--ease-out) both;
  }

  .page-header > :nth-child(2) {
    animation-delay: 60ms;
  }

  .page-title {
    max-width: 18ch;
    font-size: var(--text-title);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
  }

  .page-lede {
    max-width: var(--prose-max);
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.55;
  }
</style>
