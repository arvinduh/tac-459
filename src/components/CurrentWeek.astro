---
/**
 * Marks the week that is happening now, in the course time zone.
 *
 * Wrapped elements carrying `data-start` (a Monday) and `data-before` (the
 * next Monday) get `data-current` when today falls between them. The check
 * runs once each time the element enters the page, with no timers.
 */
interface Props {
  timeZone: string;
}

const { timeZone } = Astro.props;
---

<current-week data-time-zone={timeZone}>
  <slot />
</current-week>

<script>
  import { wallTime } from '../lib/clock';

  class CurrentWeek extends HTMLElement {
    connectedCallback(): void {
      const zone = this.dataset['timeZone'];
      if (!zone) return;
      const today = wallTime(zone, new Date()).slice(0, 10);
      const weeks = this.querySelectorAll<HTMLElement>(
        '[data-start][data-before]',
      );
      for (const week of weeks) {
        const { start = '', before = '' } = week.dataset;
        week.toggleAttribute('data-current', start <= today && today < before);
      }
    }
  }

  customElements.define('current-week', CurrentWeek);
</script>

<style>
  current-week {
    display: contents;
  }
</style>
