---
/**
 * The semester week by week, one lane per part of the course, as a table:
 * weeks are rows and parts are columns.
 *
 * Each lane runs down the weeks its part spans, with a colored edge in the
 * staff timeline's vocabulary: ink for the curriculum, Gold for the company
 * overview, Cardinal for the capstone. A part whose steps do not map one per
 * week fills its span as one cell, and its words stay in view while its
 * weeks pass. Scrolling draws each edge down as the window's middle passes,
 * and a week darkens once it is reached; nothing runs while the page is
 * still. On phones the table reads as a list: each week, then each part's
 * block, named.
 */
import type { WeekRow } from '../lib/weeks';
import { formatWeeks } from '../lib/term';

interface Lane {
  id: string;
  title: string;
  weeks: { from: number; to: number };
}

interface Props {
  lanes: Lane[];
  rows: WeekRow[];
}

const { lanes, rows } = Astro.props;
---

<table class="timeline">
  <colgroup>
    <col class="col-week" />
    {lanes.map(({ id }) => (
      <col class={`col-${id}`} />
    ))}
  </colgroup>
  <thead>
    <tr>
      <th scope="col" class="head-week data">
        Week
      </th>
      {lanes.map(({ id, title, weeks }) => (
        <th scope="col" class={`head lane-${id}`}>
          {title}
          <span class="data">{formatWeeks(weeks)}</span>
        </th>
      ))}
    </tr>
  </thead>
  <tbody>
    {rows.map(({ week, cells }) => (
      <tr class="week">
        <th scope="row" class="week-label numeral">
          Week {week}
        </th>
        {cells.map((cell, index) => {
          // A grouped part's later weeks sit under its first week's cell.
          if (cell.kind === 'continue') return null;
          const lane = lanes[index];
          return (
            <td
              class:list={[
                'cell',
                lane && `lane-${lane.id}`,
                { empty: cell.kind === 'none' },
              ]}
              rowspan={cell.kind === 'steps' ? cell.span : undefined}
            >
              {cell.kind !== 'none' && (
                <div class="cell-body">
                  {lane && <p class="cell-lane data">{lane.title}</p>}
                  {cell.kind === 'topic' && (
                    <>
                      {cell.module && (
                        <p class="module data">
                          Module {cell.module.number} · {cell.module.title}
                        </p>
                      )}
                      <h3 class="cell-title">{cell.title}</h3>
                      <ul class="plain-list topics">
                        {cell.core.map((topic) => (
                          <li>{topic}</li>
                        ))}
                      </ul>
                      {cell.deeper.length > 0 && (
                        <ul class="plain-list topics deeper">
                          {cell.deeper.map((topic) => (
                            <li>{topic}</li>
                          ))}
                        </ul>
                      )}
                    </>
                  )}
                  {cell.kind === 'step' && (
                    <>
                      <h3 class="cell-title">{cell.title}</h3>
                      <p class="cell-text">{cell.text}</p>
                    </>
                  )}
                  {cell.kind === 'steps' && (
                    <ol class="plain-list steps">
                      {cell.steps.map(({ title, text }) => (
                        <li>
                          <h3 class="cell-title">{title}</h3>
                          <p class="cell-text">{text}</p>
                        </li>
                      ))}
                    </ol>
                  )}
                </div>
              )}
            </td>
          );
        })}
      </tr>
    ))}
  </tbody>
</table>

<style>
  @property --lit {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }

  .timeline {
    --edge: var(--color-rule-strong);
    --heads: 3.75rem;

    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  /* The week column, then the curriculum wider than the two project lanes. */
  .col-week {
    width: 5.5rem;
  }

  .col-curriculum {
    width: 40%;
  }

  .lane-company-overview {
    --edge: var(--color-accent);
  }

  .lane-capstone {
    --edge: var(--color-brand);
  }

  th,
  td {
    padding: 0;
    text-align: left;
    vertical-align: top;
  }

  /* The lane names stay in view under the site header while weeks pass. */
  thead th {
    position: sticky;
    top: calc(var(--header-height) - 1px);
    z-index: 1;
    height: var(--heads);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-bg);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    vertical-align: middle;
  }

  .head {
    padding-left: var(--space-4);
    box-shadow: inset 2px 0 var(--edge);
  }

  .head .data {
    display: block;
    color: var(--color-text-subtle);
    font-weight: var(--weight-regular);
  }

  .head-week {
    color: var(--color-text-subtle);
    font-weight: var(--weight-regular);
  }

  .week {
    border-top: 1px solid var(--color-rule);
    color: color-mix(
      in srgb,
      var(--color-text) calc(var(--lit) * 100%),
      var(--color-text-subtle)
    );
  }

  .week-label {
    padding-block: var(--space-6);
    color: color-mix(
      in srgb,
      var(--color-brand) calc(var(--lit) * 100%),
      var(--color-text-subtle)
    );
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
  }

  /* Each lane's edge: a faint track, and the fill that scrolling draws. */
  .cell {
    position: relative;
    padding: var(--space-6) var(--space-6) var(--space-6) var(--space-4);
  }

  .cell:not(.empty)::before,
  .cell:not(.empty)::after {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    content: '';
  }

  .cell::before {
    background: color-mix(in srgb, var(--edge) 30%, transparent);
  }

  .cell::after {
    background: var(--edge);
    transform-origin: top;
  }

  .cell-body {
    display: grid;
    gap: var(--space-2);
  }

  /* A grouped part's words stay in view while its weeks pass. */
  [rowspan] > .cell-body {
    position: sticky;
    top: calc(var(--header-height) + var(--heads) + var(--space-6));
  }

  .cell-lane {
    display: none;
  }

  .module {
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }

  .cell-title {
    font-size: var(--text-base);
    line-height: 1.3;
  }

  .cell-text,
  .topics {
    color: color-mix(
      in srgb,
      var(--color-text-muted) calc(var(--lit) * 100%),
      var(--color-text-subtle)
    );
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .topics {
    display: grid;
    gap: var(--space-1);
  }

  .deeper {
    margin-top: var(--space-2);
    color: var(--color-text-subtle);
  }

  .steps {
    display: grid;
    gap: var(--space-6);
  }

  .steps > li {
    display: grid;
    gap: var(--space-2);
  }

  /* Phones: the table reads as a list of weeks, each part's block named. */
  @media (width < 48rem) {
    .timeline,
    tbody,
    tr,
    th,
    td {
      display: block;
    }

    thead,
    colgroup,
    .cell.empty {
      display: none;
    }

    .week-label {
      padding-block: var(--space-6) var(--space-2);
    }

    .cell {
      padding-block: var(--space-3);
    }

    .week > :last-child {
      padding-bottom: var(--space-6);
    }

    [rowspan] > .cell-body {
      position: static;
    }

    .cell-lane {
      display: block;
      color: var(--color-text-subtle);
      font-size: var(--text-xs);
    }
  }

  /*
   * The window's middle is "now": a week lights as its top reaches it, and
   * each edge draws down through its cell while the middle passes. Longhands
   * only; see .reveal.
   */
  @supports (animation-timeline: view()) {
    @media screen and (prefers-reduced-motion: no-preference) {
      .week {
        view-timeline-name: --week;
        view-timeline-axis: block;
        view-timeline-inset: 50%;
        animation-name: light;
        animation-fill-mode: both;
        animation-timing-function: linear;
        animation-timeline: --week;
        animation-range: cover 0 cover 6rem;
      }

      .cell::after {
        animation-name: draw;
        animation-fill-mode: both;
        animation-timing-function: linear;
        animation-timeline: view(block 50%);
        animation-range: cover 0% cover 100%;
      }
    }
  }

  @keyframes light {
    from {
      --lit: 0;
    }

    to {
      --lit: 1;
    }
  }

  @keyframes draw {
    from {
      transform: scaleY(0);
    }

    to {
      transform: scaleY(1);
    }
  }
</style>
