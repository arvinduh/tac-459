---
/**
 * A titled band of a page: a hairline, the section's heading, then its
 * content, all starting on the page's one left edge.
 *
 * Headings sit above their content rather than in a side column, so a
 * heading and what it introduces always line up.
 */
interface Props {
  /** Anchor for in-page links; also derives the heading's id. */
  id: string;
  label: string;
}

const { id, label } = Astro.props;
const headingId = `${id}-heading`;
---

<section class="page-width" id={id} aria-labelledby={headingId}>
  <div class="section-rule">
    <h2 class="section-label" id={headingId}>
      {label}
    </h2>
    <div>
      <slot />
    </div>
  </div>
</section>

<style>
  .section-rule {
    display: grid;
    /* minmax(0) lets wide content, such as a timeline, scroll in its box. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-rule);
  }

  .section-label {
    max-width: var(--prose-max);
    font-size: var(--text-xl);
  }
</style>
