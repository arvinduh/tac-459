---
/**
 * A titled band of a page on the site's two-column editorial grid.
 *
 * The narrow column holds the section's heading; the wide column holds the
 * slot. Below the grid breakpoint the heading stacks on top.
 */
interface Props {
  /** Anchor for in-page links; also derives the heading's id. */
  id: string;
  label: string;
  /** Short mono tag above the label, such as 'Module 2'. */
  numeral?: string;
  /** Stacks the label above the body so wide content gets the full width. */
  stacked?: boolean;
}

const { id, label, numeral, stacked = false } = Astro.props;
const headingId = `${id}-heading`;
---

<section class="page-width" id={id} aria-labelledby={headingId}>
  <div class:list={['section-grid', { stacked }]}>
    <h2 class="section-label" id={headingId}>
      {numeral && <span class="numeral">{numeral}</span>}
      {label}
    </h2>
    <div class="section-body">
      <slot />
    </div>
  </div>
</section>

<style>
  .section-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-rule);
  }

  .section-grid.stacked {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (width < 48rem) {
    .section-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }

  .section-label {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0;
  }
</style>
