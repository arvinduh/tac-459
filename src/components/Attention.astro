---
/**
 * The home page's headline, one phrase to a line, with self-attention
 * drawn beside it: the headline is the picture.
 *
 * Each line has one key term, marked in the content with *asterisks*. Arcs
 * leave each line's end and curve out to the right into the lines it
 * attends to, heavier the more weight they carry. Every line's arcs rest
 * faintly at once; the lines take turns being read, top to bottom, and the
 * reading line's key term and arcs turn Cardinal. Pointing at a line reads
 * it and holds the turns. The weights are a build-time stand-in, not a
 * trained model: nearer lines score higher, with seeded variation, so any
 * headline an editor writes gets a plausible picture. The type shrinks
 * until the longest line leaves room for arcs.
 *
 * The lines are the page's real h1. The arcs depend on where the lines
 * end, so a small script measures them on load and on resize. The turns
 * run only while the headline is on screen, the tab is visible and nothing
 * is pointed at, and never under reduced motion.
 */
interface Props {
  /** The headline, one phrase per line. */
  lines: string[];
}

const { lines: marked } = Astro.props;

// '*Build* a' becomes its text before, the key term, and the text after.
const lines = marked.map((line) => {
  const [before = '', key = '', after = ''] = line.split('*');
  return { before, key, after };
});
const texts = lines.map(({ before, key, after }) => before + key + after);
const longest = Math.max(...texts.map((text) => text.length));
const longestWord = Math.max(
  ...texts.flatMap((text) => text.split(' ')).map((word) => word.length),
);

/** A stable value in [0, 1) for a pair of positions. */
function jitter(i: number, j: number): number {
  const x = Math.sin(i * 127.1 + j * 311.7) * 43758.5453;
  return x - Math.floor(x);
}

/** How much line i attends to line j, before normalizing. */
function score(i: number, j: number): number {
  return Math.exp(-Math.abs(i - j) / 2) * (0.5 + jitter(i, j));
}

const heads = lines.map((_, i) => {
  const scores = lines.map((_, j) => (i === j ? 0 : score(i, j)));
  const total = scores.reduce((sum, value) => sum + value, 0);
  return scores
    .map((value, j) => ({ j, weight: value / total }))
    .filter(({ j }) => j !== i)
    .toSorted((a, b) => b.weight - a.weight);
});
---

<div
  class="attention"
  style={`--longest: ${longest}; --longest-word: ${longestWord}`}
>
  <h1 class="headline">
    {lines.map(({ before, key, after }, i) => (
      <>
        <span class="phrase" data-phrase={i}>
          {before}
          <span class="key">{key}</span>
          {after}
        </span>{' '}
      </>
    ))}
  </h1>
  <svg class="arcs" aria-hidden="true" focusable="false">
    {heads.map((arcs, i) => (
      <g class="head" data-head={i}>
        {arcs.map(({ j, weight }, rank) => (
          <path
            pathLength="1"
            data-to={j}
            style={`--weight: ${weight.toFixed(3)}; --rank: ${rank}`}
          />
        ))}
      </g>
    ))}
  </svg>
</div>

<script>
  /** Space between a phrase's end and where its arcs leave, in pixels. */
  const GAP = 14;
  /** How far an arc bulges per pixel between its lines, before fitting. */
  const BULGE = 1;
  /** How long each line is read before the next one's turn. */
  const TURN_MS = 3200;

  /** Lays every arc out from where the lines end. */
  function layout(root: HTMLElement): void {
    const box = root.getBoundingClientRect();
    const ends = Array.from(
      root.querySelectorAll<HTMLElement>('.phrase'),
      (phrase) => {
        // A phrase may wrap on a phone; its arcs leave its last line.
        const range = document.createRange();
        range.selectNodeContents(phrase);
        const rects = range.getClientRects();
        const rect = rects[rects.length - 1] ?? phrase.getBoundingClientRect();
        const widest = Math.max(...Array.from(rects, ({ right }) => right));
        return {
          // The rightmost edge of any of its lines, which arcs must clear.
          edge: Math.max(widest, rect.right) - box.left + GAP,
          x: rect.right - box.left + GAP,
          y: rect.top - box.top + rect.height * 0.56,
        };
      },
    );
    const arcs = Array.from(
      root.querySelectorAll<SVGPathElement>('.head path'),
      (path) => {
        const i = Number(path.closest('g')?.dataset['head']);
        const j = Number(path.dataset['to']);
        // Clear every line the arc passes, not just its two ends.
        const passed = ends.slice(Math.min(i, j), Math.max(i, j) + 1);
        const clear = Math.max(...passed.map(({ edge }) => edge));
        return { path, from: ends[i], to: ends[j], clear };
      },
    );
    // One scale for every arc, so the widest still fits the box.
    let fit = 1;
    for (const { from, to, clear } of arcs) {
      if (!from || !to) continue;
      const reach = Math.abs(to.y - from.y) * BULGE;
      const room = box.width - 4 - clear;
      if (reach > 0) fit = Math.min(fit, Math.max(room, 0) / reach);
    }
    for (const { path, from, to, clear } of arcs) {
      if (!from || !to) continue;
      // A cubic with both controls at x = out peaks, halfway along, at
      // 0.75 out + 0.125 (from + to); solve so the peak clears the lines.
      const peak = clear + Math.abs(to.y - from.y) * BULGE * fit;
      const out = (peak - 0.125 * (from.x + to.x)) / 0.75;
      path.setAttribute(
        'd',
        `M${from.x} ${from.y}C${out} ${from.y} ${out} ${to.y} ${to.x} ${to.y}`,
      );
    }
  }

  /** Draws one line's arcs in, over the resting ones. */
  function activate(root: HTMLElement, index: string): void {
    for (const head of root.querySelectorAll<SVGGElement>('.head')) {
      const active = head.dataset['head'] === index;
      head.classList.toggle('is-active', active);
      // SVG paints in document order, so the active line's arcs go last.
      if (active) head.parentNode?.append(head);
    }
    for (const phrase of root.querySelectorAll<HTMLElement>('.phrase')) {
      phrase.classList.toggle('is-active', phrase.dataset['phrase'] === index);
    }
  }

  /** Lays out the arcs and runs the turns for one headline. */
  function start(root: HTMLElement): void {
    const count = root.querySelectorAll('.phrase').length;
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let turn = 0;
    let onScreen = false;
    let held = false;
    let timer: ReturnType<typeof setTimeout> | undefined;

    // Fires once on observe, then on every resize; fonts can shift lines.
    const sizes = new ResizeObserver(() => layout(root));
    sizes.observe(root);
    void document.fonts.ready.then(() => layout(root));

    /** Schedules the next turn, or stops when nobody would see it. */
    function schedule(): void {
      clearTimeout(timer);
      if (calm || held || !onScreen || document.hidden) return;
      timer = setTimeout(() => {
        turn = (turn + 1) % count;
        activate(root, String(turn));
        schedule();
      }, TURN_MS);
    }

    const sight = new IntersectionObserver(([entry]) => {
      onScreen = entry?.isIntersecting ?? false;
      schedule();
    });
    sight.observe(root);
    document.addEventListener('visibilitychange', schedule);
    activate(root, '0');

    root.addEventListener('pointerover', (event) => {
      const phrase = (event.target as Element).closest<HTMLElement>('.phrase');
      const index = phrase?.dataset['phrase'];
      if (!index) return;
      held = true;
      turn = Number(index);
      schedule();
      if (!phrase.classList.contains('is-active')) activate(root, index);
    });
    root.addEventListener('pointerleave', () => {
      held = false;
      schedule();
    });

    document.addEventListener(
      'astro:before-swap',
      () => {
        clearTimeout(timer);
        sizes.disconnect();
        sight.disconnect();
        document.removeEventListener('visibilitychange', schedule);
      },
      { once: true },
    );
  }

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('.attention');
    if (root) start(root);
  });
</script>

<style>
  .attention {
    position: relative;
    container-type: inline-size;
  }

  .headline {
    position: relative;
    z-index: 1;
    /* Geist averages about 0.54em a character. The longest line takes at
       most three quarters of the width, leaving the rest for arcs, and the
       whole headline at most about half the screen's height. */
    font-size: min(12svh, calc(75cqi / (var(--longest) * 0.54)));
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }

  /* A phone is too narrow for whole lines at a size that fills it, so the
     type is sized by the longest word instead and lines wrap. */
  @container (width < 40rem) {
    .headline {
      font-size: min(12svh, calc(78cqi / (var(--longest-word) * 0.54)));
    }

    /* Wrap before the arcs' strip, so they keep a fifth of the width. */
    .phrase {
      max-width: 80cqi;
    }
  }

  /* One phrase to a line: each is a token the arcs can reach. */
  .phrase {
    display: block;
    width: fit-content;
  }

  .key {
    transition: color var(--duration-base) var(--ease-out);
  }

  /* Only the key term lights, so the sentence still reads as one. */
  .phrase.is-active .key {
    color: var(--color-brand);
  }

  .arcs {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .head path {
    fill: none;
    stroke: var(--color-rule-strong);
    stroke-linecap: round;
    stroke-width: calc(0.75px + var(--weight) * 2.5px);
    transition: stroke var(--duration-base) var(--ease-out);
  }

  /* The phrase being read: its arcs draw in, strongest first. */
  .head.is-active path {
    stroke: var(--color-brand);
    stroke-dasharray: 1;
    stroke-width: calc(1.5px + var(--weight) * 8px);
    animation: draw var(--duration-draw) var(--ease-out) both;
    animation-delay: calc(var(--rank) * 90ms);
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }
</style>
