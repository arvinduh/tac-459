---
/**
 * The home page's headline, one phrase to a line, with self-attention
 * drawn beside it: the headline is the picture.
 *
 * Arcs leave each phrase's end and curve out to the right into the phrases
 * it attends to, heavier the more weight they carry. Every phrase's arcs
 * rest faintly at once; one phrase's draw in Cardinal, first the one the
 * others attend to most, then whichever is pointed at. The weights are a
 * build-time stand-in, not a trained model: nearer phrases score higher,
 * with seeded variation, so any headline an editor writes gets a plausible
 * picture. The type shrinks until the longest line leaves room for arcs.
 *
 * The phrases are the page's real h1. The arcs depend on where the lines
 * end, so a small script measures them on load and on resize only;
 * without it the headline still reads.
 */
interface Props {
  /** The headline, one phrase per line. */
  lines: string[];
}

const { lines } = Astro.props;
const longest = Math.max(...lines.map((line) => line.length));

/** A stable value in [0, 1) for a pair of positions. */
function jitter(i: number, j: number): number {
  const x = Math.sin(i * 127.1 + j * 311.7) * 43758.5453;
  return x - Math.floor(x);
}

/** How much line i attends to line j, before normalizing. */
function score(i: number, j: number): number {
  return Math.exp(-Math.abs(i - j) / 2) * (0.5 + jitter(i, j));
}

const heads = lines.map((_, i) => {
  const scores = lines.map((_, j) => (i === j ? 0 : score(i, j)));
  const total = scores.reduce((sum, value) => sum + value, 0);
  return scores
    .map((value, j) => ({ j, weight: value / total }))
    .filter(({ j }) => j !== i)
    .toSorted((a, b) => b.weight - a.weight);
});

// The phrase that draws on load: the one the others attend to most.
const received = lines.map((_, j) =>
  heads
    .flat()
    .filter((arc) => arc.j === j)
    .reduce((sum, { weight }) => sum + weight, 0),
);
const query = received.indexOf(Math.max(...received));
---

<div class="attention" data-query={query} style={`--longest: ${longest}`}>
  <h1 class="headline">
    {lines.map((line, i) => (
      <>
        <span class="phrase" data-phrase={i}>
          {line}
        </span>{' '}
      </>
    ))}
  </h1>
  <svg class="arcs" aria-hidden="true" focusable="false">
    {heads.map((arcs, i) => (
      <g class="head" data-head={i}>
        {arcs.map(({ j, weight }, rank) => (
          <path
            pathLength="1"
            data-to={j}
            style={`--weight: ${weight.toFixed(3)}; --rank: ${rank}`}
          />
        ))}
      </g>
    ))}
  </svg>
</div>

<script>
  /** Space between a phrase's end and where its arcs leave, in pixels. */
  const GAP = 14;
  /** How far an arc bulges per pixel between its lines, before fitting. */
  const BULGE = 1;

  /** Lays every arc out from where the lines end. */
  function layout(root: HTMLElement): void {
    const box = root.getBoundingClientRect();
    const ends = Array.from(
      root.querySelectorAll<HTMLElement>('.phrase'),
      (phrase) => {
        const rect = phrase.getBoundingClientRect();
        return {
          x: rect.right - box.left + GAP,
          y: rect.top - box.top + rect.height * 0.56,
        };
      },
    );
    const arcs = Array.from(
      root.querySelectorAll<SVGPathElement>('.head path'),
      (path) => ({
        path,
        from: ends[Number(path.closest('g')?.dataset['head'])],
        to: ends[Number(path.dataset['to'])],
      }),
    );
    // One scale for every arc, so the widest still fits the box.
    let fit = 1;
    for (const { from, to } of arcs) {
      if (!from || !to) continue;
      const reach = Math.abs(to.y - from.y) * BULGE;
      const room = box.width - 4 - Math.max(from.x, to.x);
      if (reach > 0) fit = Math.min(fit, Math.max(room, 0) / reach);
    }
    for (const { path, from, to } of arcs) {
      if (!from || !to) continue;
      // A cubic peaks at three quarters of its control points' offset.
      const bulge = (Math.abs(to.y - from.y) * BULGE * fit) / 0.75;
      const out = Math.max(from.x, to.x) + bulge;
      path.setAttribute(
        'd',
        `M${from.x} ${from.y}C${out} ${from.y} ${out} ${to.y} ${to.x} ${to.y}`,
      );
    }
  }

  /** Draws one phrase's arcs in, over the resting ones. */
  function activate(root: HTMLElement, index: string): void {
    for (const head of root.querySelectorAll<SVGGElement>('.head')) {
      const active = head.dataset['head'] === index;
      head.classList.toggle('is-active', active);
      // SVG paints in document order, so the active phrase's arcs go last.
      if (active) head.parentNode?.append(head);
    }
    for (const phrase of root.querySelectorAll<HTMLElement>('.phrase')) {
      phrase.classList.toggle('is-active', phrase.dataset['phrase'] === index);
    }
  }

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('.attention');
    if (!root) return;
    // Fires once on observe, then on every resize; fonts can shift lines.
    const observer = new ResizeObserver(() => layout(root));
    observer.observe(root);
    void document.fonts.ready.then(() => layout(root));
    activate(root, root.dataset['query'] ?? '0');
    root.addEventListener('pointerover', (event) => {
      const phrase = (event.target as Element).closest<HTMLElement>('.phrase');
      const index = phrase?.dataset['phrase'];
      if (index && !phrase.classList.contains('is-active')) {
        activate(root, index);
      }
    });
    document.addEventListener(
      'astro:before-swap',
      () => observer.disconnect(),
      { once: true },
    );
  });
</script>

<style>
  .attention {
    position: relative;
    container-type: inline-size;
  }

  .headline {
    position: relative;
    z-index: 1;
    /* Geist averages about 0.54em a character; the longest line takes at
       most four fifths of the width, leaving the rest for arcs. */
    font-size: min(var(--text-display), calc(80cqi / (var(--longest) * 0.54)));
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
  }

  /* One phrase to a line: each is a token the arcs can reach. */
  .phrase {
    display: block;
    width: fit-content;
    transition: color var(--duration-base) var(--ease-out);
  }

  .phrase.is-active {
    color: var(--color-brand);
  }

  .arcs {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .head path {
    fill: none;
    stroke: var(--color-rule-strong);
    stroke-linecap: round;
    stroke-width: calc(0.75px + var(--weight) * 2.5px);
    transition: stroke var(--duration-base) var(--ease-out);
  }

  /* The phrase being read: its arcs draw in, strongest first. */
  .head.is-active path {
    stroke: var(--color-brand);
    stroke-dasharray: 1;
    stroke-width: calc(1.5px + var(--weight) * 8px);
    animation: draw var(--duration-draw) var(--ease-out) both;
    animation-delay: calc(var(--rank) * 90ms);
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }
</style>
