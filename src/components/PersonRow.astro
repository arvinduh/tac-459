---
/**
 * One person as a single row: portrait, name, roles and an optional detail
 * line, linking to their page.
 *
 * The portrait and name share transition names with the person page.
 */
import type { CollectionEntry } from 'astro:content';
import { href } from '../lib/paths';
import Portrait from './Portrait.astro';

interface Props {
  person: CollectionEntry<'people'>;
  /** Replaces the positions under the name, e.g. with a short role. */
  caption?: string;
  /** An extra quiet line, such as office hours. */
  detail?: string;
  /** Shows the person's short bio under their roles. */
  withSummary?: boolean;
}

const { person, caption, detail, withSummary } = Astro.props;
const { name, honorific, positions, summary } = person.data;
const lines = caption ? [caption] : positions;
---

<a class="person-row" href={href(`/team/${person.id}/`)}>
  <Portrait person={person} size={72} />
  <span class="person-text">
    <span class="person-name" transition:name={`name-${person.id}`}>
      {honorific ? `${honorific} ${name}` : name}
    </span>
    <span class="person-roles">
      {lines.map((line) => (
        <span>{line}</span>
      ))}
    </span>
    {detail && <span class="person-detail data">{detail}</span>}
  </span>
  {withSummary && summary && <span class="person-summary">{summary}</span>}
</a>

<style>
  .person-row {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    padding-block: var(--space-6);
    color: var(--color-text);
    text-decoration: none;
  }

  .person-row:is(:hover, :focus-visible) :global(.portrait) {
    filter: grayscale(0);
  }

  .person-text {
    display: grid;
    gap: var(--space-1);
  }

  .person-name {
    width: fit-content;
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: 1.2;
    letter-spacing: var(--tracking-heading);
    padding-bottom: 0.15em;
    /* A Gold underline draws in from the left, like the onward links. */
    background: linear-gradient(var(--color-accent), var(--color-accent))
      no-repeat 0 100% / 0% 2px;
    transition: background-size var(--duration-base) var(--ease-out);
  }

  .person-row:is(:hover, :focus-visible) .person-name {
    background-size: 100% 2px;
  }

  .person-roles {
    display: grid;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Under the name on wide screens; the full row width on phones. */
  .person-summary {
    grid-column: 2;
    max-width: var(--prose-max);
    color: var(--color-text-muted);
  }

  @media (width < 36rem) {
    .person-summary {
      grid-column: 1 / -1;
    }
  }

  .person-detail {
    margin-top: var(--space-1);
  }
</style>
