---
/** One line under a hairline naming the course and its school. */
interface Props {
  courseCode: string;
  title: string;
}

const { courseCode, title } = Astro.props;
---

<footer class="page-width site-footer">
  <div class="footer-line">
    <p>
      {courseCode} · {title}
    </p>
    <p>USC Viterbi School of Engineering</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-section);
  }

  /* The rule sits inside the gutters so it lines up with the content. */
  .footer-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-rule);
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
  }
</style>
