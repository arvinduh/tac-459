---
/**
 * The bottom of every page: one line naming the course and the school that
 * offers it. Navigation lives in the header alone, so nothing repeats.
 */
interface Props {
  courseCode: string;
  title: string;
}

const { courseCode, title } = Astro.props;
---

<footer class="page-width site-footer">
  <p class="footer-line">
    <span class="footer-code">{courseCode}</span>
    <span>{title}</span>
    <a href="https://viterbischool.usc.edu/">
      USC Viterbi School of Engineering
    </a>
  </p>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-section);
  }

  /* The rule sits inside the gutters so it lines up with the content. */
  .footer-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-6);
    padding-block: var(--space-6) var(--space-8);
    border-top: 1px solid var(--color-rule);
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .footer-code {
    color: var(--color-brand);
    font: var(--weight-semibold) var(--text-xs) / 1.6 var(--font-mono);
    letter-spacing: 0.04em;
  }

  .footer-line a {
    color: inherit;
  }

  .footer-line a:hover {
    color: var(--color-text);
  }
</style>
