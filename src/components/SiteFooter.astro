---
/** Closing band naming the course and the program it belongs to. */
interface Props {
  courseCode: string;
  title: string;
  tagline: string;
}

const { courseCode, title, tagline } = Astro.props;
---

<footer class="site-footer">
  <div class="page-width footer-body">
    <p class="footer-course">
      {courseCode} · {title}
    </p>
    <p class="footer-program">{tagline} · USC Viterbi School of Engineering</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-16);
    border-top: 4px solid var(--color-accent);
    background: var(--color-inverse-bg);
    color: var(--color-on-brand);
  }

  .footer-body {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-12);
  }

  .footer-course {
    font: var(--text-lg) / 1.3 var(--font-display);
  }

  .footer-program {
    opacity: 0.8;
    font-size: var(--text-sm);
  }
</style>
