---
/**
 * The next few deadlines, judged against now in the course time zone.
 *
 * The build renders every dated deliverable in due order. In the browser,
 * past items and those beyond `limit` hide, and an empty state appears once
 * nothing is left. Without JavaScript, the full list shows.
 */
interface Props {
  timeZone: string;
  limit: number;
  /** Deliverables in due order; `key` is term.ts's dueKey. */
  items: { key: string; title: string; when: string }[];
}

const { timeZone, limit, items } = Astro.props;
---

<up-next class="up-next" data-time-zone={timeZone} data-limit={limit}>
  <h2 class="up-next-title">Up next</h2>
  <ol class="up-next-list">
    {items.map(({ key, title, when }) => (
      <li class="up-next-item" data-due={key}>
        <span class="up-next-name">{title}</span>
        <span class="up-next-when">{when}</span>
      </li>
    ))}
  </ol>
  <p class="up-next-empty" hidden>
    Every deliverable is in for this term.
  </p>
</up-next>

<script>
  import { wallTime } from '../lib/clock';

  class UpNext extends HTMLElement {
    connectedCallback(): void {
      const zone = this.dataset['timeZone'];
      const limit = Number(this.dataset['limit']);
      if (!zone || !Number.isFinite(limit)) return;
      const now = wallTime(zone, new Date());
      let shown = 0;
      for (const item of this.querySelectorAll<HTMLElement>('[data-due]')) {
        const upcoming = (item.dataset['due'] ?? '') > now;
        item.hidden = !upcoming || shown >= limit;
        if (!item.hidden) shown += 1;
      }
      const empty = this.querySelector<HTMLElement>('.up-next-empty');
      if (empty) empty.hidden = shown > 0;
    }
  }

  customElements.define('up-next', UpNext);
</script>

<style>
  .up-next {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid color-mix(in srgb, var(--color-on-brand) 18%, transparent);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-on-brand) 8%, transparent);
    backdrop-filter: blur(8px);
    color: var(--color-on-brand);
  }

  .up-next-title {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .up-next-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .up-next-item {
    display: grid;
    gap: var(--space-1);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
  }

  .up-next-item[hidden],
  .up-next-empty[hidden] {
    display: none;
  }

  .up-next-name {
    font-weight: 600;
  }

  .up-next-when {
    opacity: 0.8;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }
</style>
