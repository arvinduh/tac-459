---
/**
 * An ordered list of steps, one per row under a hairline.
 *
 * Each row leads with its semester week when the steps are one per week
 * from `firstWeek`, or else its two-digit position, so the order reads at a
 * glance.
 */
import type { CollectionEntry } from 'astro:content';

type Component = CollectionEntry<'overview'>['data']['components'][number];

interface Props {
  steps: Component['steps'];
  /** Semester week of the first step, when there is one step per week. */
  firstWeek?: number;
}

const { steps, firstWeek } = Astro.props;
---

<ol class="plain-list">
  {steps.map(({ title, text }, index) => (
    <li class="numbered-row reveal">
      <span class="numeral">
        {firstWeek === undefined
          ? String(index + 1).padStart(2, '0')
          : `Week ${firstWeek + index}`}
      </span>
      <div class="step-body">
        <h3 class="step-title">{title}</h3>
        <p class="step-text">{text}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .step-body {
    display: grid;
    gap: var(--space-2);
  }

  .step-title {
    font-size: var(--text-lg);
  }

  .step-text {
    max-width: var(--prose-max);
    color: var(--color-text-muted);
  }
</style>
