---
/**
 * The top of every page: the course wordmark, linking home, and the menu.
 *
 * It holds still during page transitions so only the content below moves.
 */
import { href } from '../lib/paths';
import Menu from './Menu.astro';

interface Props {
  courseCode: string;
}

const { courseCode } = Astro.props;
---

<header
  class="page-width site-header"
  transition:name="site-header"
  transition:animate="none"
>
  <a class="wordmark" href={href('/')}>
    {courseCode}
  </a>
  <Menu />
</header>

<style>
  /* Tall enough to clear the fixed menu dot at the top right. */
  .site-header {
    display: flex;
    align-items: center;
    min-height: calc(var(--menu-dot) + 2 * var(--space-6));
  }

  .wordmark {
    color: var(--color-brand);
    font: var(--weight-semibold) var(--text-sm) / 1 var(--font-mono);
    letter-spacing: 0.04em;
    text-decoration: none;
  }
</style>
