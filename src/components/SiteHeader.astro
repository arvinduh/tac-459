---
/**
 * One quiet line at the top: the course code and links to home sections.
 *
 * It holds still during page transitions so only the content below moves.
 * The links point at sections of the home page, so they work from any page.
 */
import { href } from '../lib/paths';

interface Props {
  courseCode: string;
}

const NAV = [
  { label: 'Course', anchor: 'course' },
  { label: 'Curriculum', anchor: 'curriculum' },
  { label: 'Team', anchor: 'team' },
];

const { courseCode } = Astro.props;
---

<header
  class="page-width site-header"
  transition:name="site-header"
  transition:animate="none"
>
  <a class="wordmark" href={href('/')}>
    {courseCode}
  </a>
  <nav aria-label="Sections">
    <ul class="nav-list">
      {NAV.map(({ label, anchor }) => (
        <li>
          <a class="nav-link" href={href(`/#${anchor}`)}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }

  .wordmark,
  .nav-link {
    text-decoration: none;
  }

  .wordmark {
    font: 500 var(--text-xs) / 1 var(--font-mono);
    letter-spacing: 0.02em;
  }

  .nav-list {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--color-text);
  }
</style>
