---
/**
 * The top of every page: a slim bar holding the course wordmark, linking
 * home, and the menu. It sticks to the top of the window.
 *
 * It holds still during page transitions so only the content below moves.
 */
import { href } from '../lib/paths';
import Menu from './Menu.astro';

interface Props {
  courseCode: string;
}

const { courseCode } = Astro.props;
---

<header
  class="site-header"
  transition:name="site-header"
  transition:animate="none"
>
  <div class="page-width header-bar">
    <a class="wordmark" href={href('/')}>
      {courseCode}
    </a>
    <Menu />
  </div>
</header>

<style>
  /*
   * A Cardinal line tops the bar, and a hairline appears under it once the
   * page scrolls. The bar is solid paper: a blurred, see-through bar costs
   * a filter pass on every scrolled frame and shows a seam at the top.
   */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-top: var(--header-rule) solid var(--color-brand);
    border-bottom: 1px solid transparent;
    background: var(--color-bg);
  }

  @supports (animation-timeline: scroll()) {
    .site-header {
      /* Longhands only; see .reveal in base.css. */
      animation-name: header-rule;
      animation-fill-mode: both;
      animation-timing-function: linear;
      animation-timeline: scroll();
      animation-range: 0 var(--space-16);
    }
  }

  @keyframes header-rule {
    to {
      border-bottom-color: var(--color-rule);
    }
  }

  .header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    height: calc(var(--header-height) - var(--header-rule) - 1px);
  }

  .wordmark {
    color: var(--color-brand);
    font: var(--weight-semibold) var(--text-sm) / 1 var(--font-mono);
    letter-spacing: 0.04em;
    text-decoration: none;
  }
</style>
