---
/**
 * The arrow that ends every link leading onward: a chevron that grows a
 * shaft and slides forward when its link is hovered or focused.
 *
 * Purely decorative; its styles live in base.css with the link styles it
 * belongs to.
 */
---

<svg class="arrow" viewBox="0 0 10 10" aria-hidden="true">
  <path class="arrow-shaft" d="M0 5h7"></path>
  <path class="arrow-head" d="M1 1l4 4-4 4"></path>
</svg>
