---
/**
 * A slow, full-width wall of real student products: two rows of covers
 * drifting in opposite directions, each tile linking to its product.
 *
 * It is the home page's first proof, shown before any explanation. Each
 * row holds its covers twice so the drift loops without a seam; the copy
 * is hidden from assistive tech and the keyboard. A row pauses under the
 * pointer, and both pause while the wall is off screen, so nothing runs
 * when no one can see it. Reduced motion leaves the rows still.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { href } from '../lib/paths';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const half = Math.ceil(projects.length / 2);
const rows = [projects.slice(0, half), projects.slice(half)];
---

<div class="wall" data-wall>
  {rows.map((row, rowIndex) => (
    <div class:list={['wall-row', { reverse: rowIndex === 1 }]}>
      <ul class="plain-list wall-track">
        {[0, 1].map((copy) =>
          row.map(({ id, data }) => (
            <li aria-hidden={copy === 1 ? 'true' : undefined}>
              <a
                class="tile"
                href={href(`/projects/${id}/`)}
                tabindex={copy === 1 ? -1 : undefined}
              >
                <Image
                  class="tile-image"
                  src={data.images[0]}
                  alt=""
                  widths={[320, 640]}
                  sizes="20rem"
                />
                <span class="tile-title">{data.title}</span>
              </a>
            </li>
          )),
        )}
      </ul>
    </div>
  ))}
</div>

<script>
  // Pause the drift while the wall is off screen; reruns after navigation.
  let observer: IntersectionObserver | undefined;
  document.addEventListener('astro:page-load', () => {
    observer?.disconnect();
    observer = new IntersectionObserver((entries) => {
      for (const { target, isIntersecting } of entries) {
        target.toggleAttribute('data-offscreen', !isIntersecting);
      }
    });
    for (const wall of document.querySelectorAll('[data-wall]')) {
      observer.observe(wall);
    }
  });
</script>

<style>
  /* Edges fade into the paper so the rows seem to come from off page. */
  .wall {
    display: grid;
    gap: var(--space-4);
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
  }

  .wall-track {
    display: flex;
    gap: var(--space-4);
    width: max-content;
    animation: drift 120s linear infinite;
  }

  .reverse .wall-track {
    animation-direction: reverse;
  }

  .wall-row:hover .wall-track,
  .wall[data-offscreen] .wall-track {
    animation-play-state: paused;
  }

  @keyframes drift {
    to {
      transform: translateX(calc(-50% - var(--space-4) / 2));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wall-track {
      animation: none;
    }
  }

  .tile {
    position: relative;
    display: block;
    width: clamp(13rem, 22vw, 20rem);
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: 0 0 0 1px var(--color-rule);
  }

  .tile-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  /* The title rises over a soft scrim only when the tile is pointed at. */
  .tile-title {
    position: absolute;
    inset: auto 0 0;
    padding: var(--space-8) var(--space-4) var(--space-3);
    background: linear-gradient(transparent, var(--color-scrim));
    color: var(--color-bg);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .tile:is(:hover, :focus-visible) .tile-image {
    transform: scale(1.04);
  }

  .tile:is(:hover, :focus-visible) .tile-title {
    opacity: 1;
    transform: none;
  }
</style>
