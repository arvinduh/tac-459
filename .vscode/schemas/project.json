{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "team": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 160,
      "description": "One sentence for cards and search results."
    },
    "description": {
      "type": "string",
      "description": "What the product does."
    },
    "built": {
      "type": "string",
      "description": "How the team built it."
    }
  },
  "required": [
    "title",
    "team",
    "summary",
    "description",
    "built"
  ],
  "additionalProperties": false
}
