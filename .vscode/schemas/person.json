{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "honorific": {
      "description": "e.g. 'Prof.'",
      "type": "string"
    },
    "positions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "email": {
      "type": "string",
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
    },
    "links": {
      "default": {},
      "type": "object",
      "properties": {
        "linkedin": {
          "type": "string",
          "format": "uri"
        },
        "viterbi": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "description": "A short bio for the team page.",
      "type": "string"
    }
  },
  "required": [
    "name",
    "positions"
  ],
  "additionalProperties": false
}
